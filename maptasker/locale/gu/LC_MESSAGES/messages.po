msgstr "ભાષા પર સેટ છે"
msgid "Display Options"
msgstr "પ્રદર્શન વિકલ્પો"
msgid "Display Detail Level:"
msgstr "ડિસ્પ્લે ડિટેલ લેવલ:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "આ આઉટપુટમાં પ્રદર્શિત વિગતોની માત્રા નક્કી કરે છે.\n\nસ્તર 0 = સૌથી ઓછી વિગત, 5 = સૌથી વધુ વિગત."

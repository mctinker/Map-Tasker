msgstr "Загрузка..."

msgid "Fill all three fields in from the loaded configuration."
msgstr "Заполните все три поля из загруженной конфигурации."

msgid "Import Into Tasker"
msgstr "Импортировать в Таскер"

msgid "Listing the XML files on the Android device..."
msgstr "Вывод списка XML-файлов на устройстве Android..."

msgid "More matches than can be shown -- narrow the search."
msgstr "Больше совпадений, чем может быть показано — сузьте поиск."

msgid "No Icon"
msgstr "Нет значка"

msgid "Or a Tasker variable:"
msgstr "Или переменная Tasker:"

msgid "Pick"
msgstr "Выбор"


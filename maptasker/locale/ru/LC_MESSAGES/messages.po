msgstr "Показать/изменить ключ(и) API"
msgid "Change Prompt"
msgstr "Изменить запрос"
msgid "Model to Use:"
msgstr "Модель для использования:"
msgid "Extended"
msgstr "Расширенный"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "Отображение расширенного списка ВСЕХ доступных моделей.\n\nПримечание. Если ключ API не установлен для OpenAI или Gemini,\nпоявится список моделей по умолчанию для соответствующего\nпровайдера AI.\n\nПримечание: не все модели были проверены, и\nни одна или несколько моделей могут возвращать ошибку при анализе."
msgid "Populates the 'Debug' tab."
msgstr "Заполняет вкладку «Отладка»."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "Отобразите настройки этой программы в начале вывода конфигурации (вид карты и браузер)."
msgid "API Key Options"
msgstr "Параметры ключа API"
msgid "OpenAI API Key:"
msgstr "Ключ API OpenAI:"
msgid "Claude API Key:"
msgstr "Ключ API Клода:"
msgid "DeepSeek API Key:"
msgstr "Ключ API DeepSeek:"
msgid "Gemini API Key:"
msgstr "Ключ API Близнецов:"
msgid "OK"
msgstr "ХОРОШО"
msgid "Cancel"
msgstr "Отмена"
msgid "Task 'actions' limit"
msgstr "Ограничение действий задачи"
msgid "Map"
msgstr "Карта"
msgid "Monospaced Font To Use"
msgstr "Моноширинный шрифт для использования"
msgid "Current file set to"
msgstr "Текущий файл установлен на"
msgid "Current File"
msgstr "Текущий файл"
msgid "Select Project to process:"
msgstr "Выберите проект для обработки:"
msgid "Select Profile to process:"
msgstr "Выберите профиль для обработки:"
msgid "Select Task to process:"
msgstr "Выберите задачу для обработки:"
msgid "Display only Project"
msgstr "Только отображение проекта"
msgid "None"
msgstr "Никто"
msgid "Display all Projects, Profiles, Tasks, and Scenes."
msgstr "Отображение всех проектов, профилей и задач."
msgid "Display all"
msgstr "Показать все"
msgid "Run Analysis"
msgstr "Запустить анализ"
msgid "Analyze"
msgstr "Анализировать"
msgid "Project to Analyze:"
msgstr "Проект для анализа:"
msgid "Profile to Analyze:"
msgstr "Профиль для анализа:"
msgid "Task to Analyze:"
msgstr "Задача для анализа:"
msgid "No Projects, Profiles or Tasks to display!"
msgstr "Нет проектов, профилей или задач для отображения!"
msgid "Analysis response is in a separate Window."
msgstr "Ответ анализа находится в отдельном окне."
msgid "View not possible.  No Projects, Profiles Tasks (or Scenes) in the current XML file.\n"
msgstr "Просмотр невозможен.  В текущем XML-файле нет проектов, задач профилей (или сцен).\n"
msgid "Click the 'Get Local XML' or 'Get XML From Android' button to load some XML first."
msgstr "Нажмите кнопку «Получить локальный XML» или «Получить XML с Android», чтобы сначала загрузить XML."
msgid "GUI started with the '-reset' option.\n"
msgstr "Графический интерфейс запускается с параметром «-reset».\n"
msgid "Initialization complete.\n"
msgstr "Инициализация завершена.\n"
msgid "Settings restored.\n"
msgstr "Настройки восстановлены.\n"
msgid "Program running..."
msgstr "Программа работает..."
msgid "Cancel button pressed.\n"
msgstr "Нажата кнопка отмены.\n"
msgid "Invalid XML!  Click 'Get Local XML File' to try a different XML file."
msgstr "Нажмите «Получить локальный XML», чтобы попробовать другой XML-файл."
msgid "'Get XML From Android' settings cleared."
msgstr "Настройки «Получить XML с Android» удалены."
msgid "No Project(s) Found in XML!"

"Content-Transfer-Encoding: 8bit\n"

msgid "Language set to"
msgstr "زبان روی"
msgid "Display Options"
msgstr "گزینه های نمایش"
msgid "Display Detail Level:"
msgstr "سطح جزئیات نمایش:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "این مقدار جزئیات نمایش داده شده در خروجی را تعیین می کند.\n\nسطح 0 = کمترین جزئیات، 5 = بیشترین جزئیات."
msgid "Specific Name"
msgstr "نام خاص"
msgid "Diagram"
msgstr "نمودار"
msgid "Misc View"
msgstr "مشاهده متفرقه"
msgid "Analysis"
msgstr "تجزیه و تحلیل"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "برای شروع جستجوی رشته ای که در سمت چپ وارد کرده اید، روی این دکمه کلیک کنید\nو موارد منطبق را از بالا برجسته کنید.\n\nروی ? برای دریافت اطلاعات بیشتر"
msgid "Search Here"
msgstr "اینجا جستجو کنید"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "برای شروع جستجوی رشته‌ای که در سمت چپ وارد کرده‌اید، روی این دکمه کلیک کنید\nو موارد منطبق را از گوشه سمت چپ بالای صفحه برجسته کنید.\n\nروی '?' کلیک کنید. برای دریافت اطلاعات بیشتر"
msgid "Next"
msgstr "بعدی"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "رشته مطابق بعدی را قابل مشاهده کنید.\n\nروی ? برای دریافت اطلاعات بیشتر"
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "رشته تطبیق یافته قبلی را قابل مشاهده کنید.\n\nبرای کسب اطلاعات بیشتر روی علامت ? کلیک کنید."
msgid "Prev"
msgstr "قبلی"
msgid "Clear"
msgstr "پاک کردن"
msgid "Search"
msgstr "جستجو کنید"
msgid "Toggle Word Wrap"
msgstr "تغییر وضعیت Word Wrap"
msgid "Top"
msgstr "بالا"
msgid "Bottom"
msgstr "پایین"
msgid "Display Only"
msgstr "نمایش فقط"
msgid "Display only"
msgstr "فقط نمایش داده شود"
msgid "Display only the"
msgstr "فقط نمایش داده شود"
msgid "overrides any previous set name"
msgstr "هر نام مجموعه قبلی را لغو می کند"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "برای جستجو و نمایش تنها خطوطی که با رشته جستجو مطابقت دارند، روی این دکمه کلیک کنید."
msgid "Profiles Per Line:"
msgstr "پروفایل در هر خط:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "تعداد نمایه\nبرای نمایش در هر خط را انتخاب کنید.  پیش فرض 6 است.\n\nروی ? برای دریافت اطلاعات بیشتر"
msgid "Top Task"
msgstr "وظیفه برتر"
msgid "Bottom Task"
msgstr "کار پایین"
msgid "Tree"
msgstr "درخت"
msgid "map_window_position"
msgstr "نقشه_پنجره_موقعیت"
msgid "Misc"
msgstr "متفرقه"
msgid "misc_window_position"
msgstr "misc_window_position"
msgid "Displaying only the next 80 matches...\n"
msgstr "نمایش فقط 80 مورد بعدی...\n"
msgid "N/A"
msgstr "N/A"
msgid "Profiles"
msgstr "پروفایل ها"
msgid "  Tasks in Project (sorted)"
msgstr "وظایف در پروژه (مرتب شده)"
msgid "Launcher Task: "
msgstr "وظیفه راه‌انداز:"
msgid "<<< Owner=Project"
msgstr "<<< مالک=پروژه"
msgid "Project"
msgstr "پروژه"
msgid "Profile"
msgstr "نمایه"
msgid "Task"
msgstr "وظیفه"
msgid "ID:"
msgstr "شناسه:"
msgid "<<< Owner="
msgstr "<<< مالک="
msgid "Element of type"
msgstr "عنصر نوع"
msgid "\n\nActions:"
msgstr "\n\nاقدامات:"
msgid "Action"
msgstr "اقدام"
msgid "Project Global Variables"
msgstr "متغیرهای جهانی پروژه"
msgid "Task: "
msgstr "وظیفه: "
msgid "Profile: "
msgstr "نمایه: "
msgid "Project: "
msgstr "پروژه: "
msgid "Scene: "
msgstr "صحنه: "
msgid "Properties Collision Handling"
msgstr "ویژگی های برخورد برخورد"
msgid "Run Both Together"
msgstr "هر دو را با هم اجرا کنید"
msgid " Properties"
msgstr "خواص"
msgid "(Not referenced by any "
msgstr "(توسط هیچ کدام ارجاع نشده است"
msgid "Project:"
msgstr "پروژه:"
msgid "Scenes:"
msgstr "صحنه ها:"
msgid "[Called by "
msgstr "[با تماس"
msgid "[Calls "
msgstr "[ تماس می گیرد"
msgid "(entry)"
msgstr "(ورودی)"
msgid "  "
msgstr ""
msgid "Directory\n"
msgstr "دایرکتوری\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "دایرکتوری (ورودی های آبی لینک های داغ هستند)\n\n"
msgid "entire configuration"
msgstr "کل پیکربندی"
msgid "Profile:"
msgstr "نمایه:"
msgid "Task:"
msgstr "وظیفه:"
msgid "Go to top"
msgstr "به بالا بروید"
msgid ": Properties"
msgstr ": خواص"
msgid "Task "
msgstr "وظیفه"
msgid "tasks"
msgstr "وظایف"
msgid "Color for Background set to"
msgstr "رنگ برای پس‌زمینه تنظیم شده است"
msgid "highlighted for visibility"
msgstr "برای دید برجسته شده است"
msgid "Found:"
msgstr "یافت شد:"
msgid " [Launcher Task: "
msgstr "[وظیفه لانچر:"
msgid "(Not referenced by"
msgstr "(ارجاع نشده توسط"
msgid "Grand Totals"
msgstr "کل کل"
msgid "MapTasker Runtime Options"
msgstr "گزینه های زمان اجرا MapTasker"
msgid "Just Display Everything!"
msgstr "فقط همه چیز را نمایش دهید!"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "تمام چک باکس های زیر را به جز «پیچ و خم» علامت زده و سطح نمایش را روی حداکثر سطح جزئیات تنظیم می کند."
msgid "Display Profile and Task Action Conditions"
msgstr "نمایش مشخصات و شرایط عملکرد وظیفه"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "شرایطی مانند 'وضعیت'، 'رویداد'، 'زمان' و غیره را در خروجی نمایش دهید."
msgid "Display TaskerNet Info"
msgstr "نمایش اطلاعات TaskerNet"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "در صورت موجود بودن در فایل XML، «تنظیمات» Tasker را در خروجی قرار دهید."
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "فهرستی از تمام پروژه‌ها، پروفایل‌ها، وظایف و صحنه‌ها را با لینک‌های داغ در ابتدای خروجی نمایش دهید."
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "یک نمودار از پیکربندی با تمام اتصالات Task ویرایشگر متن پیش‌فرض شما نمایش داده می‌شود.\nاین گزینه فقط به دکمه‌های «اجرا و خروج» و «اجرای مجدد» مربوط می‌شود."
msgid "Display Prettier Output"
msgstr "نمایش خروجی زیباتر"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "همه آرگومان ها و پارامترهای Task action را برای خروجی بهتر تراز کنید."
msgid "Project/Profile/Task/Scene Names:"
msgstr "نام پروژه / نمایه / وظیفه / صحنه:"
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "هایلایت را به نام پروژه، نمایه و کار در خروجی اضافه کنید."
msgid "Bold"
msgstr "پررنگ"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "پررنگ و مورب در نمای نقشه متقابل هستند."
msgid "Italicize"
msgstr "کج کردن"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "کج و پررنگ در نمای نقشه متقابل هستند."
msgid "Highlight"
msgstr "برجسته کردن"
msgid "Underline"
msgstr "زیر خط بکشید"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "قبل از صدور اخطار، تعداد اقدامات موجود در یک Task را انتخاب کنید.\nهشدار نزدیک به قسمت پایین خروجی پیکربندی ظاهر می‌شود،\nو برای کمک به شناسایی کارهایی است که خیلی کامل هستند\nو احتمالاً باید به چند کار تقسیم شوند.\nتنظیم '100' به این معنی است که محدودیتی وجود ندارد."
msgid "Creates the If/Then/Else indentation options."
msgstr "گزینه های تورفتگی If/Then/Else را ایجاد می کند."
msgid "If/Then/Else Indentation Amount:"
msgstr "اگر/پس/دیگر مقدار تورفتگی:"
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "مقدار تورفتگی را برای بلوک‌های If/Then/Else تنظیم کنید.\n\nپیش‌فرض «4» است."
msgid "Creates the language selection dropdown."
msgstr "منوی کشویی انتخاب زبان را ایجاد می کند."
msgid "Language:"
msgstr "زبان:"
msgid "Creates the appearance mode selection."
msgstr "انتخاب حالت ظاهر را ایجاد می کند."
msgid "Appearance Mode:"
msgstr "حالت ظاهری:"
msgid "Light"
msgstr "نور"
msgid "Dark"
msgstr "تاریک"
msgid "System"
msgstr "سیستم"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "ایجاد دکمه برای نماهای مختلف (نقشه، نمودار، درخت)."
msgid "Views"
msgstr "بازدیدها"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "نمای دقیق پیکربندی خود را با اتصالات بین کارها نشان دهید.\n\nاین دکمه مشابه دکمه «Run» است، اما خروجی به جای مرورگر، در داخل پنجره دیگری نمایش داده می‌شود."
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "یک نمای نموداری از پیکربندی خود با اتصالات بین کارها نشان دهید.\n\nاین با دکمه «Run» ترکیب شده با کادر انتخاب «نمایش پیکربندی طرح کلی» یکسان است،\nاما خروجی به جای یک ویرایشگر متن، در داخل پنجره دیگری نمایش داده می‌شود."
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "یک نمای درختی سلسله مراتبی ساده از پیکربندی خود را نشان دهید."
msgid "Creates the view limit dropdown."
msgstr "کرکره محدودیت دید را ایجاد می کند."
msgid "View Limit:"
msgstr "محدودیت مشاهده:"
msgid "Unlimited"
msgstr "نامحدود"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "حداکثر تعداد مواردی را برای نمایش در نما انتخاب کنید تا مجاز باشد.\n\nهر چیزی بیش از این مقدار، تولید نما را به عنوان وسیله ای برای مهار کردن برنامه متوقف می کند.\n\nتوجه: این فقط برای نماهای «نقشه» و «نمودار» است، نه برای نمای درختی."
msgid "Reset Options"
msgstr "بازنشانی گزینه ها"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "همه گزینه‌ها را به مقادیر پیش‌فرض بازنشانی کنید، از جمله رنگ‌ها، فونت استفاده‌شده، و تنظیمات دیگر.\n\nXML بارگیری‌شده فعلی پاک می‌شود."
msgid "Save Settings"
msgstr "تنظیمات را ذخیره کنید"
msgid "Restore Settings"
msgstr "بازیابی تنظیمات"
msgid "Report Issue"
msgstr "گزارش مسئله"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "هرگونه مشکل و/یا پیشنهاد را به توسعه‌دهنده گزارش دهید.\n\nبا این کار یک پنجره مرورگر به صفحه مشکلات GitHub باز می‌شود و برای ارسال مشکل به یک حساب GitHub نیاز دارید."
msgid "Font To Use In Output:"
msgstr "فونت مورد استفاده در خروجی:"
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "این فهرستی از تمام فونت‌های تک‌فاصله موجود در سیستم شما است.\n\nفونت انتخاب‌شده در تمام خروجی‌ها استفاده می‌شود.\n\n«Courier» یا «Courier New» برای اطمینان از هم‌ترازی مناسب کانکتور به شدت برای نمودارها توصیه می‌شود."
msgid "Clear Messages"
msgstr "پاک کردن پیام ها"
msgid "Get XML from Android Device"
msgstr "XML را از دستگاه Android دریافت کنید"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "XML را از دستگاه Android واکشی کنید.\n\nبرای اطلاعات بیشتر روی دکمه «دریافت راهنمای Android» کلیک کنید."
msgid "Get Local XML"
msgstr "دریافت XML محلی"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "XML را از یک درایو محلی در این رایانه واکشی کنید.\n\nXML واکشی شده منبع فعلی دستورات MapTasker خواهد شد."
msgid "Display Help"
msgstr "نمایش راهنما"
msgid "Get Android Help"
msgstr "راهنمای Android را دریافت کنید"
msgid "Browser Options"
msgstr "گزینه های مرورگر"
msgid "Run and Exit"
msgstr "اجرا و خروج"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "نقشه ای از XML کنونی ایجاد کنید، نتایج را به عنوان یک فایل html ذخیره کنید و نقشه را در مرورگر پیش فرض نمایش دهید.\n\nبرنامه پس از اتمام پایان می یابد."
msgid "ReRun"
msgstr "اجرای مجدد"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "مانند دکمه 'Run and Exit'،\nاما برنامه پس از نمایش خروجی مرورگر دوباره راه اندازی می شود."
msgid "Exit"
msgstr "خارج شوید"
msgid "(Pick ONLY One)"
msgstr "(فقط یکی را انتخاب کنید)"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "یک پروژه، نمایه یا وظیفه را برای نمایش انتخاب کنید (نماهای نقشه و نمودار، و مرورگر).\nاگر یک پروژه انتخاب شود، همه پروژه‌ها، وظایف و صحنه‌های آن گنجانده می‌شود.\nاگر یک نمایه انتخاب شود، آن و همه وظایف آن نمایش داده می‌شوند."
msgid "List Unnamed Items"
msgstr "لیست موارد بدون نام"
msgid "'List Unnamed Items' checkbox"
msgstr "کادر انتخاب «فهرست موارد بدون نام»."
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "اگر می‌خواهید Profiles و Tasks بدون نام را در فهرست‌های کشویی (بالا) و در فهرست اختیاری ببینید، این را علامت بزنید.\n\nاگر این علامت را بردارید، Tasks و Profiles بدون نام\n از لیست‌های کشویی و خارج از فهرست باقی می‌مانند،\nاما نمایه بدون نام و جزئیات خروجی همچنان در فهرست ظاهر می‌شوند."
msgid "Set Various Display Colors Here:"
msgstr "رنگ های مختلف نمایشگر را در اینجا تنظیم کنید:"
msgid "Projects"
msgstr "پروژه ها"
msgid "Disabled Profiles"
msgstr "پروفایل های غیرفعال"
msgid "Launcher Tasks"
msgstr "وظایف لانچر"
msgid "Profile Conditions"
msgstr "شرایط پروفایل"
msgid "Tasks"
msgstr "وظایف"
msgid "Unnamed Tasks"
msgstr "وظایف بی نام"
msgid "(Task) Actions"
msgstr "(وظیفه) اقدامات"
msgid "Action Conditions"
msgstr "شرایط اقدام"
msgid "Action Labels"
msgstr "برچسب های اقدام"
msgid "Action Names"
msgstr "نام های اقدام"
msgid "Scenes"
msgstr "صحنه ها"
msgid "Background"
msgstr "پس زمینه"
msgid "TaskerNet Information"
msgstr "اطلاعات TaskerNet"
msgid "Tasker Preferences"
msgstr "تنظیمات Tasker"
msgid "Heading"
msgstr "سرفصل"
msgid "Reset to Default Colors"
msgstr "بازنشانی به رنگ های پیش فرض"
msgid "Show/Edit API Key(s)"
msgstr "نمایش/ویرایش کلید(های) API"
msgid "Change Prompt"
msgstr "اعلان را تغییر دهید"
msgid "Model to Use:"
msgstr "مدل مورد استفاده:"
msgid "Extended"
msgstr "تمدید شد"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "فهرست گسترده‌ای از همه مدل‌های موجود را نمایش دهید.\n\nتوجه: اگر کلید API برای OpenAI یا Gemini تنظیم نشده باشد، فهرست مدل‌های پیش‌فرض برای ارائه‌دهنده AI مربوطه نمایش داده می‌شود.\n\nتوجه: همه مدل‌ها اعتبارسنجی نشده‌اند و\nیک یا چند مدل ممکن است در تجزیه و تحلیل خطا نشان دهند."
msgid "Populates the 'Debug' tab."
msgstr "برگه «اشکال‌زدایی» را پر می‌کند."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "تنظیمات این برنامه را در جلوی خروجی پیکربندی (نمایش نقشه و مرورگر) نمایش دهید."
msgid "API Key Options"
msgstr "گزینه های کلید API"
msgid "OpenAI API Key:"
msgstr "کلید OpenAI API:"
msgid "Claude API Key:"
msgstr "کلید Claude API:"
msgid "DeepSeek API Key:"
msgstr "کلید DeepSeek API:"
msgid "Gemini API Key:"
msgstr "کلید Gemini API:"
msgid "OK"
msgstr "باشه"
msgid "Cancel"
msgstr "لغو کنید"
msgid "Task 'actions' limit"
msgstr "محدودیت «اقدامات» وظیفه"
msgid "Map"
msgstr "نقشه"
msgid "Monospaced Font To Use"
msgstr "فونت Monospaced برای استفاده"
msgid "Current file set to"

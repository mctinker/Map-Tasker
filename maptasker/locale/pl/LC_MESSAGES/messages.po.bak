msgid "Report an Issue or Request a Feature\n\n"
msgstr "Zgłoś problem lub poproś o funkcję\n\n"
msgid "Go to your browser and create a new issue or feature request, providing as much detail as possible."
msgstr "Przejdź do przeglądarki i utwórz nowy problem lub prośbę o nową funkcję, podając jak najwięcej szczegółów."
msgid "one or unnamed!"
msgstr "jeden lub bezimienny!"
msgid "View Limit set to"
msgstr "Zobacz Limit ustawiony na"

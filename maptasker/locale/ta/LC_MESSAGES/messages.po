msgstr "பண்புகள் மோதல் கையாளுதல்"
msgid "Run Both Together"
msgstr "இரண்டையும் ஒன்றாக இயக்கவும்"
msgid " Properties"
msgstr "பண்புகள்"
msgid "(Not referenced by any "
msgstr "(யாராலும் குறிப்பிடப்படவில்லை"
msgid "Project:"
msgstr "திட்டம்:"
msgid "Scenes:"
msgstr "காட்சிகள்:"
msgid "[Called by "
msgstr "[அழைப்பு"
msgid "[Calls "
msgstr "[அழைப்புகள்"
msgid "(entry)"
msgstr "(நுழைவு)"
msgid "Directory\n"
msgstr "அடைவு\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "கோப்பகம் (நீல உள்ளீடுகள் ஹாட்லிங்க்கள்)\n\n"
msgid "entire configuration"
msgstr "முழு கட்டமைப்பு"
msgid "Profile:"
msgstr "சுயவிவரம்:"
msgid "Task:"
msgstr "பணி:"
msgid "Go to top"
msgstr "மேலே செல்லவும்"

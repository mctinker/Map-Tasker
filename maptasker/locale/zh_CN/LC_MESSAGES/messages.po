msgstr "未找到任务"
msgid "Drawing the first."
msgstr "开始画第一张图。"
msgid "Duplicate this"
msgstr "复制此"
msgid "Fill in every box first."
msgstr "请先填写所有空格。"
msgid "First action"
msgstr "第一个动作"
msgid "Flowchart saved as"
msgstr "流程图已保存为"
msgid "From Task"
msgstr "从任务"
msgid "In Task"
msgstr "任务中"
msgid "Inline this call"
msgstr "将此调用语句嵌入到代码中"
msgid "Last action"
msgstr "最后行动"

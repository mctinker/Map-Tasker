msgstr "另存为"
msgid "Report an Issue or Request a Feature\n\n"
msgstr "报告问题或请求功能\n\n"
msgid "Go to your browser and create a new issue or feature request, providing as much detail as possible."
msgstr "转到您的浏览器并创建新问题或功能请求，并提供尽可能多的详细信息。"
msgid "one or unnamed!"
msgstr "一个或无名！"
msgid "View Limit set to"
msgstr "查看限制设置为"

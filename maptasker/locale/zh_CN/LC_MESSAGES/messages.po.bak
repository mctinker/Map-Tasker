msgstr ""
"Project-Id-Version: 10.0.0\n"
"Report-Msgid-Bugs-To: https://https://github.com/mctinker/Map-Tasker/issues\n"
"POT-Creation-Date: 2025-12-12 12:00+0000\n"
"PO-Revision-Date: 2025-12-12 12:00+0000\n"
"Last-Translator: Google Translate\n"
"Language-Team: LANGUAGE anon\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Language set to"
msgstr "语言设置为"
msgid "Display Options"
msgstr "显示选项"
msgid "Display Detail Level:"
msgstr "显示细节级别："
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "这决定了输出中显示的详细信息量。\n\n级别 0 = 最不详细，5 = 最详细。"
msgid "Specific Name"
msgstr "具体名称"
msgid "Diagram"
msgstr "图表"
msgid "Misc View"
msgstr "杂项视图"
msgid "Analysis"
msgstr "分析"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "单击此按钮可开始搜索您在左侧输入的字符串\n并从顶部开始突出显示匹配项。\n\n单击 ?获取更多信息。"
msgid "Search Here"
msgstr "在这里搜索"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "单击此按钮可开始搜索您在左侧输入的字符串\n并从屏幕左上角开始突出显示匹配项。\n\n单击“?”获取更多信息。"
msgid "Next"
msgstr "下一个"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "使下一个匹配的字符串可见。\n\n单击 ?获取更多信息。"
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "使之前匹配到的字符串可见。\n\n点击“？”获取更多信息。"
msgid "Prev"
msgstr "上一篇"
msgid "Clear"
msgstr "清除"
msgid "Search"
msgstr "搜索"
msgid "Toggle Word Wrap"
msgstr "切换自动换行"
msgid "Top"
msgstr "顶部"
msgid "Bottom"
msgstr "底部"
msgid "Display Only"
msgstr "仅显示"
msgid "Display only"
msgstr "仅显示"
msgid "Display only the"
msgstr "仅显示"
msgid "overrides any previous set name"
msgstr "覆盖任何先前设置的名称"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "单击此按钮可搜索并仅显示与搜索字符串匹配的行。"
msgid "Profiles Per Line:"
msgstr "每行配置文件："
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "选择每行显示\n多少个配置文件。  默认值为 6。\n\n单击 ?获取更多信息。"
msgid "Top Task"
msgstr "首要任务"
msgid "Bottom Task"
msgstr "底层任务"
msgid "Tree"
msgstr "树"
msgid "map_window_position"
msgstr "地图窗口位置"
msgid "Misc"
msgstr "杂项"
msgid "misc_window_position"
msgstr "杂项窗口位置"
msgid "Displaying only the next 80 matches...\n"
msgstr "仅显示接下来的 80 个匹配项...\n"
msgid "N/A"
msgstr "不适用"
msgid "Profiles"
msgstr "型材"
msgid "  Tasks in Project (sorted)"
msgstr "项目中的任务（已排序）"
msgid "Launcher Task: "
msgstr "启动器任务："
msgid "<<< Owner=Project"
msgstr "<<< 所有者=项目"
msgid "Project"
msgstr "项目"
msgid "Profile"
msgstr "轮廓"
msgid "Task"
msgstr "任务"
msgid "ID:"
msgstr "ID："
msgid "<<< Owner="
msgstr "<<< 所有者="
msgid "Element of type"
msgstr "类型元素"
msgid "\n\nActions:"
msgstr "\n\n行动："
msgid "Action"
msgstr "行动"
msgid "Project Global Variables"
msgstr "项目全局变量"
msgid "Task: "
msgstr "任务："
msgid "Profile: "
msgstr "轮廓："
msgid "Project: "
msgstr "项目："
msgid "Scene: "
msgstr "场景："
msgid "Properties Collision Handling"
msgstr "属性碰撞处理"
msgid "Run Both Together"
msgstr "一起运行"
msgid " Properties"
msgstr "特性"
msgid "(Not referenced by any "
msgstr "（没有被任何人引用"
msgid "Project:"
msgstr "项目："
msgid "Scenes:"
msgstr "场景："
msgid "[Called by "
msgstr "[呼叫者："
msgid "[Calls "
msgstr "[来电"
msgid "(entry)"
msgstr "（入口）"
msgid "  "
msgstr ""
msgid "Directory\n"
msgstr "目录\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "目录（蓝色条目是热链接）\n\n"
msgid "entire configuration"
msgstr "整个配置"
msgid "Profile:"
msgstr "轮廓："
msgid "Task:"
msgstr "任务："
msgid "Go to top"
msgstr "转到顶部"
msgid ": Properties"
msgstr "： 特性"
msgid "Task "
msgstr "任务"
msgid "tasks"
msgstr "任务"
msgid "Color for Background set to"
msgstr "背景颜色设置为"
msgid "highlighted for visibility"
msgstr "突出显示以提高可见性"
msgid "Found:"
msgstr "成立："
msgid " [Launcher Task: "
msgstr "[启动器任务："
msgid "(Not referenced by"
msgstr "（未引用"
msgid "Grand Totals"
msgstr "总计"
msgid "MapTasker Runtime Options"
msgstr "MapTasker 运行时选项"
msgid "Just Display Everything!"
msgstr "只需显示一切！"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "选中除“twisty”之外的以下所有复选框，并将显示级别设置为最大细节级别。"
msgid "Display Profile and Task Action Conditions"
msgstr "显示配置文件和任务操作条件"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "在输出中显示“状态”、“事件”、“时间”等条件。"
msgid "Display TaskerNet Info"
msgstr "显示 TaskerNet 信息"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "如果 XML 文件中提供了 Tasker“首选项”，则将其包含在输出中。"
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "显示所有项目、配置文件、任务和场景的目录，并在输出开头带有热链接。"
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "在默认文本编辑器中显示包含所有任务连接的配置图。\n此选项仅与“运行并退出”和“重新运行”按钮相关。"
msgid "Display Prettier Output"
msgstr "显示更漂亮的输出"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "对齐所有任务操作参数和参数以获得更好的输出。"
msgid "Project/Profile/Task/Scene Names:"
msgstr "项目/配置文件/任务/场景名称："
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "在输出中添加突出显示项目、配置文件和任务名称。"
msgid "Bold"
msgstr "大胆的"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "粗体和斜体在地图视图中是互斥的。"
msgid "Italicize"
msgstr "斜体"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "斜体和粗体在地图视图中是互斥的。"
msgid "Highlight"
msgstr "强调"
msgid "Underline"
msgstr "强调"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "选择发出警告之前任务中的操作数量。\n警告出现在配置输出底部附近，\n旨在帮助识别过于复杂的任务\n以及可能需要分解为多个任务的任务。\n设置“100”表示没有限制。"
msgid "Creates the If/Then/Else indentation options."
msgstr "创建 If/Then/Else 缩进选项。"
msgid "If/Then/Else Indentation Amount:"
msgstr "If/Then/Else 缩进量："
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "设置 If/Then/Else 块的缩进量。\n\n默认值为“4”。"
msgid "Creates the language selection dropdown."
msgstr "创建语言选择下拉列表。"
msgid "Language:"
msgstr "语言："
msgid "Creates the appearance mode selection."
msgstr "创建外观模式选择。"
msgid "Appearance Mode:"
msgstr "外观模式："
msgid "Light"
msgstr "光"
msgid "Dark"
msgstr "黑暗的"
msgid "System"
msgstr "系统"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "为不同视图（地图、图表、树）创建按钮。"
msgid "Views"
msgstr "意见"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "显示配置的详细视图以及任务之间的连接。\n\n这与“重新运行”按钮相同，但输出显示在另一个窗口内而不是浏览器中。"
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "显示配置的图表视图，以及任务之间的连接。\n\n这与“重新运行”按钮与选定的“显示配置大纲”复选框的组合相同，\n但输出显示在另一个窗口内而不是文本编辑器中。"
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "显示配置的简单分层树视图。"
msgid "Creates the view limit dropdown."
msgstr "创建视图限制下拉列表。"
msgid "View Limit:"
msgstr "查看限制："
msgid "Unlimited"
msgstr "无限"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "选择允许在视图中显示的最大项目数。\n\n超过此数量的任何内容都将停止生成视图，以此作为限制程序的手段。\n\n注意：这仅适用于“地图”和“图表”视图，不适用于树视图。"
msgid "Reset Options"
msgstr "重置选项"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "将所有选项重置为其默认值，包括颜色、使用的字体和其他设置。\n\n当前加载的 XML 将被清除。"
msgid "Save Settings"
msgstr "保存设置"
msgid "Restore Settings"
msgstr "恢复设置"
msgid "Report Issue"
msgstr "报告问题"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "向开发人员报告任何问题和/或建议。\n\n这将打开一个浏览器窗口，转到 GitHub 问题页面，您需要一个 GitHub 帐户才能提交问题。"
msgid "Font To Use In Output:"
msgstr "输出中使用的字体："
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "这是系统上可用的所有等宽字体的列表。\n\n所选字体将在所有输出中使用。\n\n强烈建议图表使用“Courier”或“Courier New”，以确保连接器正确对齐。"
msgid "Clear Messages"
msgstr "明确的信息"
msgid "Get XML from Android Device"
msgstr "从 Android 设备获取 XML"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "从 Android 设备获取 XML。\n\n单击“获取 Android 帮助”按钮了解详细信息。"
msgid "Get Local XML"
msgstr "获取本地 XML"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "从此计算机上的本地驱动器获取 XML。\n\n获取的 XML 将成为 MapTasker 命令的当前源。"
msgid "Display Help"
msgstr "显示帮助"
msgid "Get Android Help"
msgstr "获取 Android 帮助"
msgid "Browser Options"
msgstr "浏览器选项"
msgid "Run and Exit"
msgstr "运行并退出"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "生成当前 XML 的地图，将结果保存为 html 文件并在默认浏览器中显示该地图。\n\n完成后程序终止。"
msgid "ReRun"
msgstr "重新运行"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "与“运行并退出”按钮相同，\n但程序在显示浏览器输出后重新启动。"
msgid "Exit"
msgstr "出口"
msgid "(Pick ONLY One)"
msgstr "（仅选择一项）"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "选择要显示的单个项目、配置文件或任务（地图和图表视图以及浏览器）。\n如果选择单个项目，则将包含其所有项目、任务和场景。\n如果选择单个配置文件，则将显示该项目及其所有任务。"
msgid "List Unnamed Items"
msgstr "列出未命名的项目"
msgid "'List Unnamed Items' checkbox"
msgstr "“列出未命名项目”复选框"
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "如果您想要在下拉列表（上面）和可选目录中查看\n未命名的配置文件和任务，请选中此选项。\n\n不选中此选项将使未命名的任务和配置文件\n位于下拉列表和目录之外，\n但未命名的配置文件和任务详细信息仍将显示在输出中。"
msgid "Set Various Display Colors Here:"
msgstr "在这里设置各种显示颜色："
msgid "Projects"
msgstr "项目"
msgid "Disabled Profiles"
msgstr "残疾人资料"
msgid "Launcher Tasks"
msgstr "启动器任务"
msgid "Profile Conditions"
msgstr "简介条件"
msgid "Tasks"
msgstr "任务"
msgid "Unnamed Tasks"
msgstr "未命名任务"
msgid "(Task) Actions"
msgstr "（任务）行动"
msgid "Action Conditions"
msgstr "行动条件"
msgid "Action Labels"
msgstr "动作标签"
msgid "Action Names"
msgstr "动作名称"
msgid "Scenes"
msgstr "场景"
msgid "Background"
msgstr "背景"
msgid "TaskerNet Information"
msgstr "任务网信息"
msgid "Tasker Preferences"
msgstr "任务执行者偏好设置"
msgid "Heading"
msgstr "标题"
msgid "Reset to Default Colors"
msgstr "重置为默认颜色"
msgid "Show/Edit API Key(s)"
msgstr "显示/编辑 API 密钥"
msgid "Change Prompt"
msgstr "更改提示"
msgid "Model to Use:"
msgstr "使用型号："
msgid "Extended"
msgstr "扩展"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "显示所有可用模型的扩展列表。\n\n注意：如果未为 OpenAI 或 Gemini 设置 API 密钥，\n则将显示相应\nAI 提供程序的默认模型列表。\n\n注意：并非所有模型都经过验证，\n一个或多个模型可能会在分析时返回错误。"
msgid "Populates the 'Debug' tab."
msgstr "填充“调试”选项卡。"
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "在配置输出（地图视图和浏览器）的前面显示该程序的设置。"
msgid "API Key Options"
msgstr "API 密钥选项"
msgid "OpenAI API Key:"
msgstr "OpenAI API 密钥："
msgid "Claude API Key:"
msgstr "克劳德 API 密钥："
msgid "DeepSeek API Key:"
msgstr "DeepSeek API 密钥："
msgid "Gemini API Key:"
msgstr "双子座 API 密钥："
msgid "OK"
msgstr "好的"
msgid "Cancel"
msgstr "取消"
msgid "Task 'actions' limit"
msgstr "任务“操作”限制"
msgid "Map"
msgstr "地图"
msgid "Monospaced Font To Use"
msgstr "要使用的等宽字体"
msgid "Current file set to"
msgstr "当前文件设置为"
msgid "Current File"
msgstr "当前文件"
msgid "Select Project to process:"
msgstr "选择要处理的项目："
msgid "Select Profile to process:"
msgstr "选择要处理的配置文件："
msgid "Select Task to process:"
msgstr "选择要处理的任务："
msgid "Display only Project"
msgstr "仅显示项目"
msgid "None"
msgstr "没有任何"
msgid "Display all Projects, Profiles, and Tasks."
msgstr "显示所有项目、配置文件和任务。"
msgid "Display all"
msgstr "显示全部"
msgid "Run Analysis"
msgstr "运行分析"
msgid "Analyze"
msgstr "分析"
msgid "Project to Analyze:"
msgstr "待分析项目："
msgid "Profile to Analyze:"
msgstr "要分析的配置文件："
msgid "Task to Analyze:"
msgstr "待分析任务："
msgid "No Projects, Profiles or Tasks to display!"
msgstr "没有可显示的项目、配置文件或任务！"
msgid "Analysis response is in a separate Window."
msgstr "分析响应位于单独的窗口中。"
msgid "View not possible.  No Projects, Profiles Tasks (or Scenes) in the current XML file.\n"
msgstr "无法查看。  当前 XML 文件中没有项目、配置文件任务（或场景）。\n"
msgid "Click the 'Get Local XML' or 'Get XML From Android' button to load some XML first."
msgstr "单击“获取本地 XML”或“从 Android 获取 XML”按钮首先加载一些 XML。"
msgid "GUI started with the '-reset' option.\n"
msgstr "GUI 使用“-reset”选项启动。\n"
msgid "Initialization complete.\n"
msgstr "初始化完成。\n"
msgid "Settings restored.\n"
msgstr "设置已恢复。\n"
msgid "Program running..."
msgstr "程序运行..."
msgid "Cancel button pressed.\n"
msgstr "已按下取消按钮。\n"
msgid "Click 'Get Local XML' to try a different XML file."
msgstr "单击“获取本地 XML”尝试不同的 XML 文件。"
msgid "'Get XML From Android' settings cleared."
msgstr "已清除“从 Android 获取 XML”设置。"
msgid "No Project(s) Found in XML!"
msgstr "在 XML 中找不到项目！"
msgid "The 'Map' view is running in the background.  Please stand by..."
msgstr "“地图”视图在后台运行。  请稍等..."
msgid "Map View displayed."
msgstr "显示地图视图。"
msgid "msg"
msgstr "味精"
msgid "Colors set to defaults."
msgstr "颜色设置为默认值。"
msgid "No settings file found."
msgstr "未找到设置文件。"
msgid "'Get XML From Android' canceled."
msgstr "“从 Android 获取 XML”已取消。"
msgid "Red"
msgstr "红色的"
msgid "Settings reset."
msgstr "设置重置。"
msgid "Debug mode enabled."
msgstr "调试模式已启用。"
msgid "Debug mode disabled."
msgstr "调试模式已禁用。"
msgid "Tasker items set back to their default colors."
msgstr "任务者项目设置回默认颜色。"
msgid "Program updated.  Restarting..."
msgstr "程序已更新。  正在重新启动..."
msgid "Error: Failed to open output in browser: your browser is not supported."
msgstr "错误：无法在浏览器中打开输出：不支持您的浏览器。"
msgid "Selection ignored."
msgstr "选择被忽略。"
msgid "No color selected."
msgstr "未选择颜色。"
msgid "This has no effect with Display Detail Level less than 3.  Display Detail Level set to 3!"
msgstr "这对于显示详细级别小于 3 没有影响。显示详细级别设置为 3！"
msgid "'Twisty' and 'Everything' are mutually exclusive.  Unchecking 'Twisty'."
msgstr "“扭曲”和“一切”是相互排斥的。  取消选中“扭曲”。"
msgid "Settings saved."
msgstr "设置已保存。"
msgid "Tree View displayed."
msgstr "显示树视图。"
msgid "XML must have at least one Project."
msgstr "XML 必须至少有一个项目。"
msgid "'Cancel' button selected.  No change to the API keys!"
msgstr "选择“取消”按钮。  API 密钥没有变化！"
msgid "No API keys changed."
msgstr "API 密钥没有更改。"
msgid "No model selected."
msgstr "未选择型号。"
msgid "No projects, profiles, or tasks have been loaded!  Load some XML and try again."
msgstr "尚未加载任何项目、配置文件或任务！  加载一些 XML 并重试。"
msgid "Single Project/Profile/Task has not been selected!  Select only one and try again."
msgstr "尚未选择单个项目/配置文件/任务！  仅选择一项，然后重试。"
msgid "An error occurred reading the changelog file."
msgstr "读取更改日志文件时发生错误。"
msgid "The 'Diagram' view is running in the background.  Please stand by..."
msgstr "“图表”视图在后台运行。  请稍等..."
msgid "Diagram View displayed."
msgstr "显示图表视图。"
msgid "'None' selected.  Displaying all Projects, Profiles and Tasks."
msgstr "选择“无”。  显示所有项目、配置文件和任务。"
msgid "set Off"
msgstr "出发"
msgid "set On"
msgstr "设置为开"
msgid "set to False"
msgstr "设置为假"
msgid "set to True"
msgstr "设置为 True"
msgid "is not named"
msgstr "没有命名"
msgid "set to"
msgstr "设置为"
msgid "is not set"
msgstr "未设置"
 # Restore settings text
msgid "Android Get XML TCP IP Address"
msgstr "Android 获取 XML TCP IP 地址"
msgid "ndroid Get XML Port Number"
msgstr "android 获取 XML 端口号"

msgstr "componente(s)"

msgid "connectors"
msgstr "conectores"

msgid "drag or nudge any of them and they all move together."
msgstr "Arrastra o empuja cualquiera de ellos y todos se moverán juntos."

msgid "element(s)"
msgstr "elementos)"


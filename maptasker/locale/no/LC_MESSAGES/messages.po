msgstr "Ingenting var endret."

msgid "Press Preview first."
msgstr "Først pressepresentasjonen."

msgid "Rename this variable"
msgstr "Endre navnet på denne variabelen"

msgid "Replace"
msgstr "Erstatt"

msgid "Replace preview could not be saved."
msgstr "Muligheten til å lagre forhåndsvisningen ble ikke opprettet."


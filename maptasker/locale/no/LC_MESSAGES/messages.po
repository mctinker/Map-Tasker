msgstr "komponent(er)"

msgid "connectors"
msgstr "koblinger"

msgid "drag or nudge any of them and they all move together."
msgstr "dra eller dytte noen av dem, og de beveger seg alle sammen."

msgid "editing 1 of"
msgstr "redigering 1 av"

msgid "element(s)"
msgstr "element(er)"

msgid "elements selected"
msgstr "elementer valgt"

msgid "is not a whole number"
msgstr "er ikke et helt tall"

msgid "lines dropped"
msgstr "linjer falt"

msgid "none"
msgstr "ingen"

msgid "not drawn"
msgstr "ikke tegnet"

msgid "pair"
msgstr "par"


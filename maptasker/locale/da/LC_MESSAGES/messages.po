msgid "Display with a monospaced font (e.g. Courier New) for accurate column alignment. And turn off line wrap.\nIcons or Chinese/Korean/Japanese in names can cause minor mis-alignment."
msgstr "Brug en monospaced skrifttype (f.eks. Courier New) for præcis kolonnejustering. Og slå linjeafbrydning fra.\nIkoner eller navne med kinesiske/koreanske/japanske tegn kan forårsage mindre justeringsproblemer."

msgid "Drawn for"
msgstr "Udtaget fra"

msgid "Error: Single item specified but not found!  Try again."
msgstr "Fejl: Et enkelt element er angivet, men det blev ikke fundet! Prøv igen."

msgid "In this action"
msgstr "I denne handling"

msgid "Nothing in scope has that argument to change."
msgstr "Ingen af de punkter, der er relevant, kan ændres."

msgid "Only the matching text"
msgstr "Kun den matchende tekst"

msgid "Only where the value contains (optional)"
msgstr "Kun hvor værdien indeholder (valgfrit)"

msgid "Press Diagram View to rebuild it."
msgstr "Tryk på Diagram View for at genopbygge den."


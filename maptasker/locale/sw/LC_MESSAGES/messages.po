msgid "No Projects, Profiles or Tasks to display!"
msgstr "Hakuna Miradi, Wasifu au Kazi za kuonyesha!"
msgid "Analysis response is in a separate Window."
msgstr "Jibu la uchanganuzi liko kwenye Dirisha tofauti."
msgid "View not possible.  No Projects, Profiles Tasks (or Scenes) in the current XML file.\n"
msgstr "Mtazamo hauwezekani.  Hakuna Miradi, Kazi za Wasifu (au Mandhari) katika faili ya sasa ya XML.\n"
msgid "Click the 'Get Local XML' or 'Get XML From Android' button to load some XML first."
msgstr "Bofya kitufe cha 'Pata XML ya Ndani' au 'Pata XML Kutoka kwa Android' ili kupakia baadhi ya XML kwanza."
msgid "GUI started with the '-reset' option.\n"
msgstr "GUI ilianza na chaguo la '-reset'.\n"
msgid "Initialization complete.\n"
msgstr "Uanzishaji umekamilika.\n"
msgid "Settings restored.\n"
msgstr "Mipangilio imerejeshwa.\n"
msgid "Program running..."
msgstr "Mpango unaendelea..."
msgid "Cancel button pressed.\n"
msgstr "Kitufe cha kughairi kimebonyezwa.\n"
msgid "Invalid XML!  Click 'Get Local XML File' to try a different XML file."
msgstr "Bofya 'Pata XML ya Ndani' ili kujaribu faili tofauti ya XML."
msgid "'Get XML From Android' settings cleared."
msgstr "Mipangilio ya 'Pata XML Kutoka kwa Android' imefutwa."
msgid "No Project(s) Found in XML!"
msgstr "Hakuna Miradi Iliyopatikana katika XML!"
msgid "The 'Map' view is running in the background.  Please stand by..."
msgstr "Mwonekano wa 'Ramani' unaendelea chinichini.  Tafadhali simama karibu..."
msgid "Map View displayed."
msgstr "Mwonekano wa Ramani umeonyeshwa."
msgid "msg"
msgstr "ujumbe"
msgid "Colors set to defaults."
msgstr "Rangi zimewekwa kwa chaguo-msingi."
msgid "No settings file found."
msgstr "Hakuna faili ya mipangilio iliyopatikana."
msgid "'Get XML From Android' canceled."
msgstr "'Pata XML Kutoka kwa Android' imeghairiwa."
msgid "Red"
msgstr "Nyekundu"
msgid "Settings reset."
msgstr "Mipangilio imewekwa upya."
msgid "Debug mode enabled."
msgstr "Hali ya utatuzi imewashwa."
msgid "Debug mode disabled."
msgstr "Hali ya utatuzi imezimwa."
msgid "Tasker items set back to their default colors."
msgstr "Vipengee vya Tasklor vimewekwa nyuma kwa rangi zao chaguomsingi."
msgid "Program updated.  Restarting..."
msgstr "Programu imesasishwa.  Inaanza upya..."
msgid "Error: Failed to open output in browser: your browser is not supported."
msgstr "Hitilafu: Imeshindwa kufungua towe kwenye kivinjari: kivinjari chako hakitumiki."
msgid "Selection ignored."
msgstr "Uteuzi umepuuzwa."
msgid "No color selected."
msgstr "Hakuna rangi iliyochaguliwa."
msgid "This has no effect with Display Detail Level less than 3.  Display Detail Level set to 3!"
msgstr "Hii haina athari kwa Kiwango cha Maelezo ya Onyesho chini ya 3. Kiwango cha Maelezo ya Onyesho kimewekwa kuwa 3!"
msgid "'Twisty' and 'Everything' are mutually exclusive.  Unchecking 'Twisty'."
msgstr "'Twisty' na 'Kila kitu' ni za kipekee.  Inaondoa kuteua 'Twisty'."
msgid "Settings saved."
msgstr "Mipangilio imehifadhiwa."
msgid "Tree View displayed."
msgstr "Mwonekano wa Mti umeonyeshwa."
msgid "XML must have at least one Project."
msgstr "XML lazima iwe na angalau Mradi mmoja."
msgid "'Cancel' button selected.  No change to the API keys!"
msgstr "Kitufe cha 'Ghairi' kimechaguliwa.  Hakuna mabadiliko kwa funguo za API!"
msgid "No API keys changed."
msgstr "Hakuna vitufe vya API vilivyobadilishwa."
msgid "No model selected."
msgstr "Hakuna muundo uliochaguliwa."
msgid "No projects, profiles, or tasks have been loaded!  Load some XML and try again."
msgstr "Hakuna miradi, wasifu, au kazi zilizopakiwa!  Pakia baadhi ya XML na ujaribu tena."
msgid "Single Project/Profile/Task has not been selected!  Select only one and try again."
msgstr "Mradi/Wasifu/Kazi Moja haijachaguliwa!  Chagua moja tu na ujaribu tena."
msgid "An error occurred reading the changelog file."

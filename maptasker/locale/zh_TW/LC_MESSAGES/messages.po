msgstr "專案"
msgid "Disabled Profiles"
msgstr "殘疾人資料"
msgid "Launcher Tasks"
msgstr "啟動器任務"
msgid "Profile Conditions"
msgstr "簡介條件"
msgid "Tasks"
msgstr "任務"
msgid "Unnamed Tasks"
msgstr "未命名任務"

msgid "Language set to"
msgstr "زبان سیٹ کی گئی ہے"
msgid "Display Options"
msgstr "ڈسپلے کے اختیارات"
msgid "Display Detail Level:"
msgstr "تفصیل کی سطح کی سطح:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "یہ آؤٹ پٹ میں دکھائے جانے والے تفصیل کی مقدار کا تعین کرتا ہے۔ \n\nlevel 0 = کم سے کم تفصیل ، 5 = سب سے زیادہ تفصیل۔"
msgid "Specific Name"
msgstr "مخصوص نام"
msgid "Diagram"
msgstr "ڈایاگرام"
msgid "Misc View"
msgstr "متفرق نظریہ"
msgid "Analysis"
msgstr "تجزیہ"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "آپ نے بائیں طرف داخل ہونے والے تار کی تلاش شروع کرنے کے لئے اس بٹن پر کلک کریں۔ مزید معلومات حاصل کرنے کے لئے۔"
msgid "Search Here"
msgstr "یہاں تلاش کریں"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "اسکرین کے اوپری بائیں کونے سے شروع کرتے ہوئے ، بائیں طرف داخل ہونے والے تار کی تلاش شروع کرنے کے لئے اس بٹن پر کلک کریں۔ مزید معلومات حاصل کرنے کے لئے۔"
msgid "Next"
msgstr "اگلا"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "اگلی مماثل تار کو مرئی بنائیں۔\n\n کلیک کریں؟ مزید معلومات حاصل کرنے کے لئے۔"
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "پچھلی مماثل اسٹرنگ کو مرئی بنائیں۔\n\nپر کلک کریں؟ مزید معلومات حاصل کرنے کے لیے۔"
msgid "Prev"
msgstr "prep"
msgid "Clear"
msgstr "صاف"
msgid "Search"
msgstr "تلاش"
msgid "Toggle Word Wrap"
msgstr "ٹوگل ورڈ لپیٹ"
msgid "Top"
msgstr "اوپر"
msgid "Bottom"
msgstr "نیچے"
msgid "Display Only"
msgstr "صرف ڈسپلے کریں"
msgid "Display only"
msgstr "صرف ڈسپلے کریں"
msgid "Display only the"
msgstr "صرف ڈسپلے کریں"
msgid "overrides any previous set name"
msgstr "کسی بھی پچھلے سیٹ نام کو اوور رائڈس"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "تلاش کرنے کے لئے اس بٹن پر کلک کریں اور صرف ان لائنوں کو ظاہر کریں جو تلاش کے تار سے مماثل ہیں۔"
msgid "Profiles Per Line:"
msgstr "فی لائن پروفائلز:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "منتخب کریں کہ کتنے پروفائلز\n فی لائن ڈسپلے کریں۔  پہلے سے طے شدہ 6.\n\n کلیک ہے؟ مزید معلومات حاصل کرنے کے لئے۔"
msgid "Top Task"
msgstr "ٹاپ ٹاسک"
msgid "Bottom Task"
msgstr "نیچے کام"
msgid "Tree"
msgstr "درخت"
msgid "map_window_position"
msgstr "میپ_ ونڈو_پوزیشن"
msgid "Misc"
msgstr "متفرق"
msgid "misc_window_position"
msgstr "misc_window_position"
msgid "Displaying only the next 80 matches...\n"
msgstr "صرف اگلے 80 میچوں کی نمائش ...\n"
msgid "N/A"
msgstr "n/a"
msgid "Profiles"
msgstr "پروفائلز"
msgid "  Tasks in Project (sorted)"
msgstr "پروجیکٹ میں کام (ترتیب دیا گیا)"
msgid "Launcher Task: "
msgstr "لانچر ٹاسک:"
msgid "<<< Owner=Project"
msgstr "<<< مالک = پروجیکٹ"
msgid "Project"
msgstr "پروجیکٹ"
msgid "Profile"
msgstr "پروفائل"
msgid "Task"
msgstr "کام"
msgid "ID:"
msgstr "ID:"
msgid "<<< Owner="
msgstr "<<< مالک ="
msgid "Element of type"
msgstr "قسم کا عنصر"
msgid "\n\nActions:"
msgstr "\n\nactions:"
msgid "Action"
msgstr "ایکشن"
msgid "Project Global Variables"
msgstr "پروجیکٹ عالمی متغیر"
msgid "Task: "
msgstr "کام:"
msgid "Profile: "
msgstr "فروری:"
msgid "Project: "
msgstr "پروجیکٹ:"
msgid "Scene: "
msgstr "منظر:"
msgid "Properties Collision Handling"
msgstr "پراپرٹیز تصادم ہینڈلنگ"
msgid "Run Both Together"
msgstr "دونوں ایک ساتھ چلائیں"
msgid " Properties"
msgstr "خصوصیات"
msgid "(Not referenced by any "
msgstr "(کسی کے ذریعہ حوالہ نہیں دیا گیا"
msgid "Project:"
msgstr "پروجیکٹ:"
msgid "Scenes:"
msgstr "مناظر:"
msgid "[Called by "
msgstr "[بذریعہ کہا جاتا ہے"
msgid "[Calls "
msgstr "[کالز"
msgid "(entry)"
msgstr "(اندراج)"
msgid "  "
msgstr ""
msgid "Directory\n"
msgstr "ڈائریکٹری\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "ڈائریکٹری (نیلے رنگ کے اندراجات ہاٹ لنکس ہیں)\n\n"
msgid "entire configuration"
msgstr "پوری ترتیب"
msgid "Profile:"
msgstr "فروری:"
msgid "Task:"
msgstr "کام:"
msgid "Go to top"
msgstr "اوپر جائیں"
msgid ": Properties"
msgstr ": خصوصیات"
msgid "Task "
msgstr "کام"
msgid "tasks"
msgstr "کام"
msgid "Color for Background set to"
msgstr "پس منظر کے لئے رنگین رنگ"
msgid "highlighted for visibility"
msgstr "مرئیت کے لئے روشنی ڈالی گئی"
msgid "Found:"
msgstr "ملا:"
msgid " [Launcher Task: "
msgstr "[لانچر ٹاسک:"
msgid "(Not referenced by"
msgstr "(حوالہ نہیں دیا گیا"
msgid "Grand Totals"
msgstr "گرینڈ کل"
msgid "MapTasker Runtime Options"
msgstr "میپٹاسکر رن ٹائم آپشنز"
msgid "Just Display Everything!"
msgstr "بس سب کچھ ڈسپلے کریں!"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "نیچے دیئے گئے تمام چیک باکسز کو 'Twisty' کے علاوہ چیک کرتا ہے اور ڈسپلے کی سطح کو زیادہ سے زیادہ تفصیل کی سطح پر سیٹ کرتا ہے۔"
msgid "Display Profile and Task Action Conditions"
msgstr "پروفائل اور ٹاسک ایکشن کی شرائط ڈسپلے کریں"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "آؤٹ پٹ میں 'ریاست' ، 'واقعہ' ، 'وقت' ، وغیرہ جیسے حالات کو ظاہر کریں۔"
msgid "Display TaskerNet Info"
msgstr "ٹاسکرنیٹ کی معلومات ڈسپلے کریں"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "اگر XML فائل میں دستیاب ہو تو ، ٹاسکر کی 'ترجیحات' کو آؤٹ پٹ میں شامل کریں۔"
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "آؤٹ پٹ کے آغاز میں ہاٹ لنکس کے ساتھ تمام منصوبوں ، پروفائلز ، کاموں اور مناظر کی ڈائرکٹری دکھائیں۔"
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "آپ کے پہلے سے طے شدہ ٹیکسٹ ایڈیٹر کے ساتھ تمام ٹاسک کنکشن کے ساتھ ترتیب کا ایک آریھ ڈسپلے کریں۔ this n یہ آپشن صرف 'رن اینڈ ایگزٹ' اور 'ریرون' بٹنوں سے متعلق ہے۔"
msgid "Display Prettier Output"
msgstr "پریٹیئر آؤٹ پٹ ڈسپلے کریں"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "اچھے آؤٹ پٹ کے لئے تمام ٹاسک ایکشن دلائل اور پیرامیٹرز کو سیدھ کریں۔"
msgid "Project/Profile/Task/Scene Names:"
msgstr "پروجیکٹ/پروفائل/ٹاسک/منظر نام:"
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "آؤٹ پٹ میں پروجیکٹ ، پروفائل اور ٹاسک ناموں میں نمایاں کریں۔"
msgid "Bold"
msgstr "بولڈ"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "بولڈ اور اٹیلیسائز نقشہ کے نظارے میں باہمی خصوصی ہیں۔"
msgid "Italicize"
msgstr "italicize"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "نقشہ کے نظارے میں italicize اور جرات مندانہ باہمی خصوصی ہیں۔"
msgid "Highlight"
msgstr "نمایاں کریں"
msgid "Underline"
msgstr "خفیہ لائن"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "کسی انتباہ کو جاری کرنے سے پہلے کسی کام میں کتنے اقدامات منتخب کریں۔\n انتباہ ترتیب آؤٹ پٹ کے نیچے Th4e کے قریب ظاہر ہوتا ہے ،\nand کا مقصد ان کاموں کی نشاندہی کرنے میں مدد کرنا ہے جو بہت زیادہ کامپل ہیں۔"
msgid "Creates the If/Then/Else indentation options."
msgstr "اگر/تو/اور انڈینٹیشن کے اختیارات پیدا کرتا ہے۔"
msgid "If/Then/Else Indentation Amount:"
msgstr "اگر/تو/دیگر اشارے کی رقم:"
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "if/پھر/پھر/locks کے لئے انڈینٹیشن کی رقم مقرر کریں۔\n\n ڈیفالٹ '4' ہے۔"
msgid "Creates the language selection dropdown."
msgstr "زبان کا انتخاب ڈراپ ڈاؤن تخلیق کرتا ہے۔"
msgid "Language:"
msgstr "زبان:"
msgid "Creates the appearance mode selection."
msgstr "ظاہری شکل کا انتخاب تخلیق کرتا ہے۔"
msgid "Appearance Mode:"
msgstr "ظاہری شکل:"
msgid "Light"
msgstr "روشنی"
msgid "Dark"
msgstr "تاریک"
msgid "System"
msgstr "نظام"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "مختلف نظاروں (نقشہ ، آریھ ، درخت) کے لئے بٹن بناتا ہے۔"
msgid "Views"
msgstr "خیالات"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "کاموں کے مابین رابطوں کے ساتھ ، اپنی ترتیب کا ایک تفصیلی نظریہ دکھائیں۔"
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "کاموں کے مابین رابطوں کے ساتھ ، اپنی ترتیب کا ایک خاکہ نگاری کا نظارہ دکھائیں۔\n\n یہ 'ریرون' بٹن سے مماثل ہے جس میں 'ڈسپلے کنفیگریشن آؤٹ لائن' چیک باکس منتخب کیا گیا ہے ، لیکن آؤٹ پٹ ٹیکسٹ ایڈیٹر کے بجائے کسی اور ونڈو کے اندر ظاہر ہوتا ہے۔"
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "اپنی ترتیب کے بارے میں ایک آسان درجہ بندی کے درخت کا نظارہ دکھائیں۔"
msgid "Creates the view limit dropdown."
msgstr "ویو کی حد ڈراپ ڈاؤن تخلیق کرتا ہے۔"
msgid "View Limit:"
msgstr "دیکھیں حد:"
msgid "Unlimited"
msgstr "لامحدود"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "اس نظارے میں ظاہر کرنے کے لئے آئٹمز کی زیادہ سے زیادہ تعداد کا انتخاب کریں۔\n\nاس رقم سے زیادہ کچھ نہ ہونے سے پروگرام کو گلا گھونٹنے کے ایک ذریعہ کے طور پر نظریہ کی نسل بند ہوجائے گی۔\n\n نوٹ: یہ صرف 'نقشہ' اور 'آریھ' کے نظاروں کے لئے ہے ، درختوں کا نظارہ نہیں۔"
msgid "Reset Options"
msgstr "دوبارہ ترتیب دینے کے اختیارات"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "رنگ ، فونٹ استعمال شدہ ، اور دیگر ترتیبات سمیت ان کی پہلے سے طے شدہ اقدار پر تمام اختیارات کو دوبارہ ترتیب دیں۔\n\n فی الحال بھری ہوئی XML کو صاف کردیا جائے گا۔"
msgid "Save Settings"
msgstr "ترتیبات کو بچائیں"
msgid "Restore Settings"
msgstr "ترتیبات کو بحال کریں"
msgid "Report Issue"
msgstr "رپورٹ جاری کریں"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "کسی بھی مسئلے اور/یا تجاویز کو ڈویلپر کو رپورٹ کریں۔\n\n یہ گیتھب ایشوز پیج پر براؤزر ونڈو کھولے گا ، اور آپ کو کوئی مسئلہ پیش کرنے کے لئے گٹ ہب اکاؤنٹ کی ضرورت ہوگی۔"
msgid "Font To Use In Output:"
msgstr "آؤٹ پٹ میں استعمال کرنے کے لئے فونٹ:"
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "یہ آپ کے سسٹم پر دستیاب تمام مونو اسپیسڈ فونٹس کی ایک فہرست ہے۔\n\n فونٹ منتخب کردہ تمام آؤٹ پٹ میں استعمال ہوگا۔\n\n'courier 'یا' کورئیر نیو 'کو مناسب کنیکٹر کی صف بندی کو یقینی بنانے کے لئے آریگرام کے لئے انتہائی سفارش کی جاتی ہے۔"
msgid "Clear Messages"
msgstr "واضح پیغامات"
msgid "Get XML from Android Device"
msgstr "اینڈروئیڈ ڈیوائس سے XML حاصل کریں"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "مزید معلومات کے لئے 'Android مدد حاصل کریں' کے بٹن پر android آلہ سے XML بازیافت کریں۔\n\n کلیک کریں۔"
msgid "Get Local XML"
msgstr "مقامی XML حاصل کریں"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "اس کمپیوٹر پر مقامی ڈرائیو سے XML بازیافت کریں۔\n\n XML بازیافت میپٹاسکر کمانڈز کا موجودہ ذریعہ بن جائے گا۔"
msgid "Display Help"
msgstr "مدد ڈسپلے کریں"
msgid "Get Android Help"
msgstr "Android مدد حاصل کریں"
msgid "Browser Options"
msgstr "براؤزر کے اختیارات"
msgid "Run and Exit"
msgstr "چلائیں اور باہر نکلیں"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "موجودہ XML کا نقشہ تیار کریں ، نتائج کو HTML فائل کے طور پر محفوظ کریں اور نقشہ کو پہلے سے طے شدہ براؤزر میں ڈسپلے کریں۔\n\n پروگرام ختم ہونے پر ختم ہوجاتا ہے۔"
msgid "ReRun"
msgstr "ریرون"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "'رن اینڈ ایگزٹ' بٹن کی طرح ہی ، brose n براؤزر آؤٹ پٹ کو ظاہر کرنے کے بعد پروگرام دوبارہ شروع ہوجاتا ہے۔"
msgid "Exit"
msgstr "باہر نکلیں"
msgid "(Pick ONLY One)"
msgstr "(صرف ایک منتخب کریں)"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "ظاہر کرنے کے لئے کسی ایک پروجیکٹ ، پروفائل ، یا ٹاسک (نقشہ اور آریھ کے نظارے ، اور براؤزر) کو منتخب کریں۔\n اگر کسی ایک پروجیکٹ کا انتخاب کیا گیا ہے تو ، اس کے تمام منصوبے ، کام اور مناظر شامل کیے جائیں گے۔\n اگر ایک ہی پروفائل منتخب کیا گیا ہے ، تو اس کے تمام کاموں کو ظاہر کیا جائے گا۔"
msgid "List Unnamed Items"
msgstr "نامعلوم اشیاء کی فہرست بنائیں"
msgid "'List Unnamed Items' checkbox"
msgstr "'نامعلوم اشیاء کی فہرست' چیک باکس"
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "اس کی جانچ پڑتال کریں کہ اگر آپ pp npuldown کی فہرستوں (اوپر) اور اختیاری ڈائرکٹری میں نامعلوم پروفائلز اور کاموں کو دیکھنا چاہتے ہیں۔\n\n اس غیر جانچ شدہ کوئ نہیں تو یہ نامعلوم کاموں اور پروفائلز کو چھوڑ دیں گے۔ پلڈاؤن کی فہرستوں میں سے n اور ڈائریکٹری سے باہر ، غیر منقولہ پروفائل اور کام کی تفصیلات اب بھی ظاہر ہوں گی۔"
msgid "Set Various Display Colors Here:"

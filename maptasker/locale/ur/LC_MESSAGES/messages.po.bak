msgstr "ڈسپلے کے ناموں کو اجاگر کیا گیا"
msgid "Display Names Italicized"
msgstr "ناموں کو ظاہر کریں"
msgid "Display Unnamed Tasks"
msgstr "نامعلوم کاموں کو ڈسپلے کریں"
msgid "Display Configuration Outline"
msgstr "کنفیگریشن آؤٹ لائن ڈسپلے کریں"
msgid "Display Tasker Preferences"
msgstr "ٹاسکر کی ترجیحات ڈسپلے کریں"

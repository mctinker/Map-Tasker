msgstr "تجزیہ کرنے کا کام:"
msgid "No Projects, Profiles or Tasks to display!"
msgstr "کوئی پروجیکٹ ، پروفائلز یا کام ظاہر کرنے کے لئے نہیں!"
msgid "Analysis response is in a separate Window."
msgstr "تجزیہ کا جواب ایک علیحدہ ونڈو میں ہے۔"
msgid "View not possible.  No Projects, Profiles Tasks (or Scenes) in the current XML file.\n"
msgstr "ممکن نہیں دیکھیں۔  موجودہ XML فائل میں کوئی پروجیکٹ ، پروفائلز کے کام (یا مناظر) نہیں۔\n"
msgid "Click the 'Get Local XML' or 'Get XML From Android' button to load some XML first."
msgstr "پہلے کچھ XML لوڈ کرنے کے لئے 'لوکل XML' یا 'Android سے XML حاصل کریں' کے بٹن پر کلک کریں۔"
msgid "GUI started with the '-reset' option.\n"
msgstr "GUI نے '-reset' آپشن کے ساتھ شروع کیا۔\n"
msgid "Initialization complete.\n"
msgstr "ابتدا مکمل.\n"
msgid "Settings restored.\n"
msgstr "ترتیبات بحال ہوگئیں۔\n"
msgid "Program running..."
msgstr "پروگرام چل رہا ہے ..."
msgid "Cancel button pressed.\n"
msgstr "منسوخ کریں بٹن دبائیں۔\n"
msgid "Click 'Get Local XML' to try a different XML file."
msgstr "ایک مختلف XML فائل کو آزمانے کے لئے 'لوکل XML حاصل کریں' پر کلک کریں۔"
msgid "'Get XML From Android' settings cleared."
msgstr "'Android سے XML حاصل کریں' کی ترتیبات صاف ہوگئیں۔"
msgid "No Project(s) Found in XML!"
msgstr "XML میں کوئی پروجیکٹ نہیں ملا!"
msgid "The 'Map' view is running in the background.  Please stand by..."
msgstr "'نقشہ' کا نظارہ پس منظر میں چل رہا ہے۔  برائے مہربانی کھڑے ہو ..."
msgid "Map View displayed."
msgstr "نقشہ ویو ظاہر ہوتا ہے۔"
msgid "msg"
msgstr "ایم ایس جی"
msgid "Colors set to defaults."
msgstr "رنگ پہلے سے طے شدہ پر سیٹ کرتے ہیں۔"
msgid "No settings file found."
msgstr "کوئی ترتیبات فائل نہیں ملی۔"
msgid "'Get XML From Android' canceled."
msgstr "'Android سے XML حاصل کریں' منسوخ ہوگیا۔"
msgid "Red"
msgstr "سرخ"
msgid "Settings reset."
msgstr "ترتیبات دوبارہ ترتیب دیں۔"
msgid "Debug mode enabled."
msgstr "ڈیبگ موڈ فعال ہے۔"
msgid "Debug mode disabled."
msgstr "ڈیبگ موڈ غیر فعال."
msgid "Tasker items set back to their default colors."
msgstr "ٹاسکر آئٹمز اپنے پہلے سے طے شدہ رنگوں پر واپس کردیئے گئے ہیں۔"
msgid "Program updated.  Restarting..."
msgstr "پروگرام اپ ڈیٹ ہوا۔  دوبارہ شروع کرنا ..."
msgid "Error: Failed to open output in browser: your browser is not supported."
msgstr "غلطی: براؤزر میں آؤٹ پٹ کھولنے میں ناکام: آپ کے براؤزر کی حمایت نہیں کی گئی ہے۔"
msgid "Selection ignored."
msgstr "انتخاب کو نظرانداز کیا گیا۔"
msgid "No color selected."
msgstr "کوئی رنگ منتخب نہیں ہوا۔"
msgid "This has no effect with Display Detail Level less than 3.  Display Detail Level set to 3!"
msgstr "اس کا 3 سے کم ڈسپلے تفصیل کی سطح کے ساتھ کوئی اثر نہیں ہے۔ ڈسپلے تفصیل کی سطح 3 پر سیٹ کریں!"
msgid "'Twisty' and 'Everything' are mutually exclusive.  Unchecking 'Twisty'."
msgstr "'Twisty' اور 'ہر چیز' باہمی خصوصی ہیں۔  'Twisty' کو غیر چیکنگ کرنا۔"
msgid "Settings saved."
msgstr "ترتیبات محفوظ ہوگئیں۔"
msgid "Tree View displayed."
msgstr "درخت کا نظارہ ظاہر ہوتا ہے۔"
msgid "XML must have at least one Project."
msgstr "XML کے پاس کم از کم ایک پروجیکٹ ہونا ضروری ہے۔"
msgid "'Cancel' button selected.  No change to the API keys!"
msgstr "'منسوخ کریں' بٹن منتخب کیا گیا۔  API کیز میں کوئی تبدیلی نہیں!"
msgid "No API keys changed."
msgstr "کوئی API کیز تبدیل نہیں ہوئی۔"
msgid "No model selected."
msgstr "کوئی ماڈل منتخب نہیں ہوا۔"
msgid "No projects, profiles, or tasks have been loaded!  Load some XML and try again."
msgstr "کوئی پروجیکٹ ، پروفائلز ، یا کام بھری ہوئی نہیں ہیں!  کچھ XML لوڈ کریں اور دوبارہ کوشش کریں۔"
msgid "Single Project/Profile/Task has not been selected!  Select only one and try again."
msgstr "سنگل پروجیکٹ/پروفائل/ٹاسک کا انتخاب نہیں کیا گیا ہے!  صرف ایک کو منتخب کریں اور دوبارہ کوشش کریں۔"
msgid "An error occurred reading the changelog file."
msgstr "چینجلگ فائل کو پڑھنے میں ایک غلطی واقع ہوئی ہے۔"
msgid "The 'Diagram' view is running in the background.  Please stand by..."
msgstr "پس منظر میں 'ڈایاگرام' نظارہ چل رہا ہے۔  برائے مہربانی کھڑے ہو ..."

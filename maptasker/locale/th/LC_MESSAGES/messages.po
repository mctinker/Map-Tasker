msgstr "เพิ่มฉาก"

msgid "Add event"
msgstr "เพิ่มกิจกรรม"

msgid "Add handler"
msgstr "เพิ่มตัวจัดการ"

msgid "Add modifier"
msgstr "เพิ่มตัวแก้ไข"

msgid "Add scene properties"
msgstr "เพิ่มคุณสมบัติของฉาก"

msgid "Addressed by id from"
msgstr "ที่อยู่โดย id จาก"

msgid "Adds an element on top of the stack, in the middle of the Scene."
msgstr "เพิ่มองค์ประกอบที่ด้านบนของสแต็กตรงกลางของฉาก"

msgid "Adds inside the selected component if it can hold children, otherwise directly after it."

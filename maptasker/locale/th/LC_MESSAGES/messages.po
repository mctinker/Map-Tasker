msgid "Color for Background set to"
msgstr "ตั้งค่าสีสำหรับพื้นหลังเป็น"
msgid "highlighted for visibility"
msgstr "เน้นให้มองเห็นได้"
msgid "Found:"
msgstr "พบ:"

msgstr "συστατικό(α)"

msgid "connectors"
msgstr "συνδετήρες"

msgid "drag or nudge any of them and they all move together."
msgstr "σύρετε ή σπρώξτε κάποιο από αυτά και κινούνται όλοι μαζί."

msgid "editing 1 of"
msgstr "επεξεργασία 1 από"

msgid "element(s)"
msgstr "στοιχεία)"


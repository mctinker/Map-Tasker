msgstr "Οι ρυθμίσεις αποθηκεύτηκαν."
msgid "Tree View displayed."
msgstr "Εμφανίζεται η προβολή δέντρου."
msgid "XML must have at least one Project."
msgstr "Η XML πρέπει να έχει τουλάχιστον ένα έργο."
msgid "'Cancel' button selected.  No change to the API keys!"
msgstr "Επιλέχθηκε το κουμπί 'Ακύρωση'.  Καμία αλλαγή στα κλειδιά API!"
msgid "No API keys changed."
msgstr "Δεν άλλαξαν κλειδιά API."

msgstr "(టాస్క్) చర్యలు"
msgid "Action Conditions"
msgstr "చర్య షరతులు"
msgid "Action Labels"
msgstr "యాక్షన్ లేబుల్స్"
msgid "Action Names"
msgstr "చర్య పేర్లు"
msgid "Scenes"
msgstr "దృశ్యాలు"
msgid "Background"
msgstr "నేపథ్యం"

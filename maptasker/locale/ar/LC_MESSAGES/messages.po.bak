msgid "Language set to"
msgstr "تم ضبط اللغة على"
msgid "Display Options"
msgstr "خيارات العرض"
msgid "Display Detail Level:"
msgstr "عرض مستوى التفاصيل:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "يحدد هذا مقدار التفاصيل المعروضة في الإخراج.\n\nالمستوى 0 = أقل التفاصيل، 5 = أكبر قدر من التفاصيل."
msgid "Specific Name"
msgstr "اسم محدد"
msgid "Diagram"
msgstr "رسم بياني"
msgid "Misc View"
msgstr "عرض متنوع"
msgid "Analysis"
msgstr "تحليل"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "انقر فوق هذا الزر لبدء البحث عن السلسلة التي أدخلتها إلى اليسار\nوتمييز التطابقات، بدءاً من الأعلى.\n\nانقر فوق ؟ للحصول على مزيد من المعلومات."
msgid "Search Here"
msgstr "ابحث هنا"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "انقر فوق هذا الزر لبدء البحث عن السلسلة التي أدخلتها إلى اليسار\nوتمييز التطابقات، بدءاً من الزاوية العلوية اليسرى من الشاشة.\n\nانقر فوق '؟' للحصول على مزيد من المعلومات."
msgid "Next"
msgstr "التالي"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "اجعل السلسلة المطابقة التالية مرئية.\n\nانقر فوق ؟ للحصول على مزيد من المعلومات."
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "اجعل السلسلة النصية المطابقة السابقة مرئية. انقر على علامة الاستفهام للحصول على مزيد من المعلومات."
msgid "Prev"
msgstr "السابق"
msgid "Clear"
msgstr "واضح"
msgid "Search"
msgstr "يبحث"
msgid "Toggle Word Wrap"
msgstr "تبديل التفاف الكلمات"
msgid "Top"
msgstr "قمة"
msgid "Bottom"
msgstr "قاع"
msgid "Display Only"
msgstr "العرض فقط"
msgid "Display only"
msgstr "العرض فقط"
msgid "Display only the"
msgstr "عرض فقط"
msgid "overrides any previous set name"
msgstr "يتجاوز أي اسم مجموعة سابقة"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "انقر فوق هذا الزر للبحث عن الأسطر التي تطابق سلسلة البحث وعرضها فقط."
msgid "Profiles Per Line:"
msgstr "الملفات الشخصية لكل سطر:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "حدد عدد ملفات التعريف\nالتي سيتم عرضها في كل سطر.  القيمة الافتراضية هي 6.\n\nانقر فوق ؟ للحصول على مزيد من المعلومات."
msgid "Top Task"
msgstr "المهمة العليا"
msgid "Bottom Task"
msgstr "المهمة السفلية"
msgid "Tree"
msgstr "شجرة"
msgid "map_window_position"
msgstr "Map_window_position"
msgid "Misc"
msgstr "متنوعات"
msgid "misc_window_position"
msgstr "Misc_window_position"
msgid "Displaying only the next 80 matches...\n"
msgstr "عرض الـ 80 مطابقة التالية فقط...\n"
msgid "N/A"
msgstr "لا يوجد"
msgid "Profiles"
msgstr "الملفات الشخصية"
msgid "  Tasks in Project (sorted)"
msgstr "المهام في المشروع (مرتبة)"
msgid "Launcher Task: "
msgstr "مهمة المشغل:"
msgid "<<< Owner=Project"
msgstr "<<< المالك=المشروع"
msgid "Project"
msgstr "مشروع"
msgid "Profile"
msgstr "حساب تعريفي"
msgid "Task"
msgstr "مهمة"
msgid "ID:"
msgstr "بطاقة تعريف:"
msgid "<<< Owner="
msgstr "<<< المالك="
msgid "Element of type"
msgstr "عنصر النوع"
msgid "\n\nActions:"
msgstr "\n\nالإجراءات:"
msgid "Action"
msgstr "فعل"
msgid "Project Global Variables"
msgstr "مشروع المتغيرات العالمية"
msgid "Task: "
msgstr "مهمة: "
msgid "Profile: "
msgstr "حساب تعريفي: "
msgid "Project: "
msgstr "مشروع: "
msgid "Scene: "
msgstr "مشهد: "
msgid "Properties Collision Handling"
msgstr "خصائص التعامل مع الاصطدام"
msgid "Run Both Together"
msgstr "تشغيل كلاهما معًا"
msgid " Properties"
msgstr "ملكيات"
msgid "(Not referenced by any "
msgstr "(لم يتم الرجوع إليها من قبل أي"
msgid "Project:"
msgstr "مشروع:"
msgid "Scenes:"
msgstr "مشاهد:"
msgid "[Called by "
msgstr "[ دعا به"
msgid "[Calls "
msgstr "[المكالمات"
msgid "(entry)"
msgstr "(دخول)"
msgid "  "
msgstr ""
msgid "Directory\n"
msgstr "الدليل\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "الدليل (الإدخالات الزرقاء هي ارتباطات سريعة)\n\n"
msgid "entire configuration"
msgstr "التكوين بأكمله"
msgid "Profile:"
msgstr "حساب تعريفي:"
msgid "Task:"
msgstr "مهمة:"
msgid "Go to top"
msgstr "اذهب إلى الأعلى"
msgid ": Properties"
msgstr ": ملكيات"
msgid "Task "
msgstr "مهمة"
msgid "tasks"
msgstr "المهام"
msgid "Color for Background set to"
msgstr "تم ضبط لون الخلفية على"
msgid "highlighted for visibility"
msgstr "أبرزت للرؤية"
msgid "Found:"
msgstr "وجد:"
msgid " [Launcher Task: "
msgstr "[مهمة المشغل:"
msgid "(Not referenced by"
msgstr "(لم تتم الإشارة إليه بواسطة"
msgid "Grand Totals"
msgstr "المجموع الكلي"
msgid "MapTasker Runtime Options"
msgstr "خيارات وقت تشغيل MapTasker"
msgid "Just Display Everything!"
msgstr "مجرد عرض كل شيء!"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "قم بتحديد جميع مربعات الاختيار أدناه باستثناء 'ملتوي' وقم بتعيين مستوى العرض على الحد الأقصى لمستوى التفاصيل."
msgid "Display Profile and Task Action Conditions"
msgstr "عرض الملف الشخصي وشروط إجراء المهمة"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "قم بعرض الشروط مثل 'الحالة' و'الحدث' و'الوقت' وما إلى ذلك في الإخراج."
msgid "Display TaskerNet Info"
msgstr "عرض معلومات تاسكر نت"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "قم بتضمين 'تفضيلات' Tasker في المخرجات، إذا كانت متوفرة في ملف XML."
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "قم بعرض دليل لجميع المشاريع والملفات الشخصية والمهام والمشاهد مع الروابط الساخنة في بداية الإخراج."
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "قم بعرض رسم تخطيطي للتكوين مع كافة اتصالات المهام في محرر النصوص الافتراضي.\nيتعلق هذا الخيار فقط بالزرين 'تشغيل وخروج' و'إعادة تشغيل'."
msgid "Display Prettier Output"
msgstr "عرض إخراج أجمل"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "قم بمحاذاة جميع وسيطات ومعلمات إجراء المهمة للحصول على نتائج أفضل."
msgid "Project/Profile/Task/Scene Names:"
msgstr "أسماء المشروع/الملف الشخصي/المهمة/المشهد:"
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "أضف تمييزًا لأسماء المشروع والملف الشخصي والمهام في المخرجات."
msgid "Bold"
msgstr "عريض"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "يعتبر Bold وItalicize متنافيين في عرض الخريطة."
msgid "Italicize"
msgstr "مائل"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "يعتبر المائل والغامق متنافيين في عرض الخريطة."
msgid "Highlight"
msgstr "تسليط الضوء"
msgid "Underline"
msgstr "تسطير"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "حدد عدد الإجراءات في المهمة قبل إصدار تحذير.\nيظهر التحذير بالقرب من أسفل إخراج التكوين،\nويهدف إلى المساعدة في تحديد المهام المكتملة\nوالتي من المحتمل أن يتم تقسيمها إلى مهام متعددة.\nيعني الإعداد '100' أنه لا يوجد حد."
msgid "Creates the If/Then/Else indentation options."
msgstr "ينشئ خيارات المسافة البادئة If/Then/Else."
msgid "If/Then/Else Indentation Amount:"
msgstr "إذا/ثم/مبلغ المسافة البادئة الأخرى:"
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "قم بتعيين مقدار المسافة البادئة للكتل If/Then/Else.\n\nالقيمة الافتراضية هي '4'."
msgid "Creates the language selection dropdown."
msgstr "إنشاء القائمة المنسدلة لاختيار اللغة."
msgid "Language:"
msgstr "لغة:"
msgid "Creates the appearance mode selection."
msgstr "إنشاء اختيار وضع المظهر."
msgid "Appearance Mode:"
msgstr "وضع المظهر:"
msgid "Light"
msgstr "ضوء"
msgid "Dark"
msgstr "مظلم"
msgid "System"
msgstr "نظام"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "إنشاء أزرار لطرق عرض مختلفة (خريطة، رسم تخطيطي، شجرة)."
msgid "Views"
msgstr "وجهات النظر"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "إظهار عرض تفصيلي للتكوين الخاص بك، مع الاتصالات بين المهام.\n\nهذا مماثل للزر 'ReRun'، ولكن يتم عرض الإخراج داخل نافذة أخرى بدلاً من عرضه في المستعرض."
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "إظهار عرض تخطيطي للتكوين الخاص بك، مع الاتصالات بين المهام.\n\nهذا مماثل للزر 'ReRun' المدمج مع تحديد خانة الاختيار 'عرض مخطط تفصيلي للتكوين'،\nولكن يتم عرض الإخراج داخل إطار آخر بدلاً من عرضه في محرر نصوص."
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "عرض عرض شجرة هرمي بسيط للتكوين الخاص بك."
msgid "Creates the view limit dropdown."
msgstr "إنشاء القائمة المنسدلة لحدود العرض."
msgid "View Limit:"
msgstr "عرض الحد:"
msgid "Unlimited"
msgstr "غير محدود"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "حدد الحد الأقصى المسموح به لعدد العناصر المراد عرضها في طريقة العرض.\n\nأي شيء يزيد عن هذا المقدار سيوقف إنشاء العرض كوسيلة لضبط البرنامج.\n\nملاحظة: هذا مخصص فقط لطريقتي العرض 'الخريطة' و'المخطط'، وليس العرض الشجري."
msgid "Reset Options"
msgstr "إعادة تعيين الخيارات"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "قم بإعادة تعيين كافة الخيارات إلى قيمها الافتراضية، بما في ذلك الألوان والخط المستخدم والإعدادات الأخرى.\n\nسيتم مسح XML المحمل حالياً."
msgid "Save Settings"
msgstr "حفظ الإعدادات"
msgid "Restore Settings"
msgstr "استعادة الإعدادات"
msgid "Report Issue"
msgstr "تقرير المشكلة"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "قم بإبلاغ المطور عن أية مشكلات و/أو اقتراحات.\n\nسيؤدي هذا إلى فتح نافذة متصفح إلى صفحة مشكلات GitHub، وستحتاج إلى حساب GitHub لإرسال مشكلة."
msgid "Font To Use In Output:"
msgstr "الخط المطلوب استخدامه في الإخراج:"
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "هذه قائمة بجميع الخطوط أحادية المسافة المتوفرة على نظامك.\n\nسيتم استخدام الخط المحدد في كافة المخرجات.\n\nيوصى بشدة باستخدام 'Courier' أو 'Courier New' للرسومات التخطيطية لضمان محاذاة الموصل بشكل صحيح."
msgid "Clear Messages"
msgstr "مسح الرسائل"
msgid "Get XML from Android Device"
msgstr "احصل على XML من جهاز Android"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "جلب XML من جهاز Android.\n\nانقر على الزر 'الحصول على تعليمات Android' للحصول على مزيد من المعلومات."
msgid "Get Local XML"
msgstr "احصل على XML المحلي"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "جلب XML من محرك أقراص محلي على هذا الكمبيوتر.\n\nسوف يصبح XML الذي تم جلبه هو المصدر الحالي لأوامر MapTasker."
msgid "Display Help"
msgstr "عرض التعليمات"
msgid "Get Android Help"
msgstr "احصل على مساعدة Android"
msgid "Browser Options"
msgstr "خيارات المتصفح"
msgid "Run and Exit"
msgstr "تشغيل وخروج"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "أنشئ خريطة لـ XML الحالي، واحفظ النتائج كملف html واعرض الخريطة في المستعرض الافتراضي.\n\nينتهي البرنامج عند الانتهاء."
msgid "ReRun"
msgstr "إعادة تشغيل"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "مثل الزر 'تشغيل وخروج'،\nلكن يتم إعادة تشغيل البرنامج بعد عرض مخرجات المتصفح."
msgid "Exit"
msgstr "مخرج"
msgid "(Pick ONLY One)"
msgstr "(اختر واحدة فقط)"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "حدد إما مشروعًا واحدًا، أو ملف تعريف، أو مهمة واحدة لعرضها (عرض الخريطة والرسم التخطيطي، والمستعرض).\nإذا تم تحديد مشروع واحد، فسيتم تضمين كافة مشاريعه ومهامه ومشاهده.\nإذا تم تحديد ملف تعريف واحد، فسيتم عرضه وجميع مهامه."
msgid "List Unnamed Items"
msgstr "قائمة العناصر غير المسماة"
msgid "'List Unnamed Items' checkbox"
msgstr "مربع الاختيار 'قائمة العناصر غير المسماة'."
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "حدد هذا إذا كنت تريد مشاهدة ملفات التعريف والمهام غير المسماة في\nالقوائم المنسدلة (أعلاه) وفي الدليل الاختياري.\n\nترك هذا بدون تحديد سيؤدي إلى ترك المهام وملفات التعريف غير المسماة\nخارج القوائم المنسدلة وخارج الدليل،\nولكن تفاصيل ملف التعريف والمهمة غير المسماة ستظل تظهر في الإخراج."
msgid "Set Various Display Colors Here:"
msgstr "اضبط ألوان العرض المختلفة هنا:"
msgid "Projects"
msgstr "المشاريع"
msgid "Disabled Profiles"
msgstr "الملفات الشخصية المعطلة"
msgid "Launcher Tasks"
msgstr "مهام المشغل"
msgid "Profile Conditions"
msgstr "شروط الملف الشخصي"
msgid "Tasks"
msgstr "المهام"
msgid "Unnamed Tasks"
msgstr "المهام غير المسماة"
msgid "(Task) Actions"
msgstr "(المهمة) الإجراءات"
msgid "Action Conditions"
msgstr "شروط العمل"
msgid "Action Labels"
msgstr "تسميات العمل"
msgid "Action Names"
msgstr "أسماء الأفعال"
msgid "Scenes"
msgstr "مشاهد"
msgid "Background"
msgstr "خلفية"
msgid "TaskerNet Information"
msgstr "معلومات تاسكر نت"
msgid "Tasker Preferences"
msgstr "تفضيلات تاسكر"
msgid "Heading"
msgstr "عنوان"
msgid "Reset to Default Colors"
msgstr "إعادة التعيين إلى الألوان الافتراضية"
msgid "Show/Edit API Key(s)"
msgstr "إظهار/تحرير مفتاح (مفاتيح) API"
msgid "Change Prompt"
msgstr "موجه التغيير"
msgid "Model to Use:"
msgstr "نموذج للاستخدام:"
msgid "Extended"
msgstr "ممتد"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "عرض قائمة موسعة بجميع النماذج المتوفرة.\n\nملاحظة: إذا لم يتم تعيين مفتاح API لـ OpenAI أو Gemini،\nفسيتم عرض قائمة النماذج الافتراضية لموفر\nAI المعني.\n\nملاحظة: لم يتم التحقق من صحة كافة النماذج\nوقد يعرض نموذج واحد أو أكثر خطأً في التحليل."
msgid "Populates the 'Debug' tab."
msgstr "يملأ علامة التبويب 'التصحيح'."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "اعرض إعدادات هذا البرنامج في مقدمة مخرجات التكوين (عرض الخريطة والمتصفح)."
msgid "API Key Options"
msgstr "خيارات مفتاح واجهة برمجة التطبيقات"
msgid "OpenAI API Key:"
msgstr "مفتاح واجهة برمجة تطبيقات OpenAI:"
msgid "Claude API Key:"
msgstr "مفتاح واجهة برمجة تطبيقات كلود:"
msgid "DeepSeek API Key:"
msgstr "مفتاح واجهة برمجة تطبيقات DeepSeek:"
msgid "Gemini API Key:"
msgstr "مفتاح واجهة برمجة تطبيقات الجوزاء:"
msgid "OK"
msgstr "نعم"
msgid "Cancel"
msgstr "يلغي"
msgid "Task 'actions' limit"
msgstr "حد 'إجراءات' المهمة"
msgid "Map"
msgstr "رسم خريطة"
msgid "Monospaced Font To Use"
msgstr "خط أحادي المسافة للاستخدام"
msgid "Current file set to"
msgstr "تم ضبط الملف الحالي على"
msgid "Current File"
msgstr "الملف الحالي"
msgid "Select Project to process:"
msgstr "حدد المشروع المراد معالجته:"
msgid "Select Profile to process:"
msgstr "حدد ملف التعريف المراد معالجته:"
msgid "Select Task to process:"
msgstr "حدد المهمة المراد معالجتها:"
msgid "Display only Project"
msgstr "عرض المشروع فقط"
msgid "None"
msgstr "لا أحد"
msgid "Display all Projects, Profiles, and Tasks."
msgstr "عرض جميع المشاريع والملفات الشخصية والمهام."
msgid "Display all"
msgstr "عرض الكل"
msgid "Run Analysis"
msgstr "تشغيل التحليل"
msgid "Analyze"
msgstr "تحليل"
msgid "Project to Analyze:"

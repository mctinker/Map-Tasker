msgstr "মানচিত্র_উইন্ডো_অবস্থান"
msgid "Misc"
msgstr "বিবিধ"
msgid "misc_window_position"
msgstr "misc_window_position"
msgid "Displaying only the next 80 matches...\n"
msgstr "শুধুমাত্র পরবর্তী 80টি ম্যাচ প্রদর্শন করা হচ্ছে...\n"

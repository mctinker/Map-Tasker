msgid "Language set to"
msgstr "ভাষা সেট করা হয়েছে"
msgid "Display Options"
msgstr "প্রদর্শনের বিকল্প"
msgid "Display Detail Level:"
msgstr "ডিসপ্লে ডিটেইল লেভেল:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "এটি আউটপুটে প্রদর্শিত বিবরণের পরিমাণ নির্ধারণ করে।\n\nস্তর 0 = সর্বনিম্ন বিশদ, 5 = সর্বাধিক বিশদ।"
msgid "Specific Name"
msgstr "নির্দিষ্ট নাম"
msgid "Diagram"
msgstr "ডায়াগ্রাম"
msgid "Misc View"
msgstr "বিবিধ দৃশ্য"
msgid "Analysis"
msgstr "বিশ্লেষণ"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "আপনি বাম দিকে প্রবেশ করা স্ট্রিংটির জন্য অনুসন্ধান শুরু করতে এই বোতামটি ক্লিক করুন\n\nএবং শীর্ষে শুরু করে মিলগুলিকে হাইলাইট করুন।\n\nএতে ক্লিক করুন? আরো তথ্য পেতে."
msgid "Search Here"
msgstr "এখানে অনুসন্ধান করুন"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "আপনি বাম দিকে প্রবেশ করা স্ট্রিংটির জন্য অনুসন্ধান শুরু করতে এই বোতামটি ক্লিক করুন\n\nএবং স্ক্রীনের উপরের-বাম কোণ থেকে শুরু করে মিলগুলি হাইলাইট করুন।\n\n'?'-এ ক্লিক করুন আরো তথ্য পেতে."
msgid "Next"
msgstr "পরবর্তী"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "পরবর্তী মিলে যাওয়া স্ট্রিংটিকে দৃশ্যমান করুন।\n\nএতে ক্লিক করুন? আরো তথ্য পেতে."
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "পূর্ববর্তী মিলে যাওয়া স্ট্রিংটি দৃশ্যমান করুন।\n\nআরও তথ্যের জন্য প্রশ্নচিহ্নে ক্লিক করুন।."
msgid "Prev"
msgstr "পূর্ববর্তী"
msgid "Clear"
msgstr "পরিষ্কার"
msgid "Search"
msgstr "অনুসন্ধান"
msgid "Toggle Word Wrap"
msgstr "শব্দ মোড়ানো টগল করুন"
msgid "Top"
msgstr "শীর্ষ"
msgid "Bottom"
msgstr "নীচে"
msgid "Display Only"
msgstr "শুধুমাত্র প্রদর্শন"
msgid "Display only"
msgstr "শুধুমাত্র প্রদর্শন"
msgid "Display only the"
msgstr "শুধুমাত্র প্রদর্শন"
msgid "overrides any previous set name"
msgstr "কোনো পূর্ববর্তী সেট নাম ওভাররাইড করে"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "অনুসন্ধান করার জন্য এই বোতামটি ক্লিক করুন এবং শুধুমাত্র অনুসন্ধান স্ট্রিংয়ের সাথে মেলে এমন লাইনগুলি প্রদর্শন করুন।"
msgid "Profiles Per Line:"
msgstr "প্রতি লাইন প্রোফাইল:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "প্রতি লাইনে কতগুলি প্রোফাইল প্রদর্শন করতে হবে তা নির্বাচন করুন৷  ডিফল্ট হল 6।\n\nএতে ক্লিক করুন? আরো তথ্য পেতে."
msgid "Top Task"
msgstr "শীর্ষ টাস্ক"
msgid "Bottom Task"
msgstr "নিচের টাস্ক"
msgid "Tree"
msgstr "গাছ"

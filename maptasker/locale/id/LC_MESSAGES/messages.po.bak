msgstr "Tampilkan Garis Besar Konfigurasi"
msgid "Display Tasker Preferences"
msgstr "Tampilkan Preferensi Tasker"
msgid "Display Prettier"
msgstr "Tampilan Lebih Cantik"
msgid "Display Runtime Settings"
msgstr "Tampilkan Pengaturan Waktu Proses"
msgid "Display TaskerNet Information"

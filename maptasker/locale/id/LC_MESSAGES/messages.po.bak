msgid "Hide Task Details Under Twisty"
msgstr "Sembunyikan Detail Tugas Di Bawah Twisty"
msgid "Display Names Underlined"
msgstr "Nama Tampilan Digarisbawahi"
msgid "Display Pretty Output"
msgstr "Menampilkan Output Cantik"
msgid "Everything toggled on successfully"
msgstr "Semuanya berhasil diaktifkan"
msgid "Everything toggled off successfully"
msgstr "Semuanya berhasil dimatikan"

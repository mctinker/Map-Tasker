msgstr "डीबग मोड"
msgid "Display Directory"
msgstr "डिस्प्ले डिरेक्टरी"
msgid "Display Names Highlighted"
msgstr "डिस्प्ले नावे हायलाइट केली"
msgid "Display Names Italicized"
msgstr "डिस्प्ले नावे इटॅलिक केलेली"
msgid "Display Unnamed Tasks"
msgstr "अनामित कार्ये प्रदर्शित करा"
msgid "Display Configuration Outline"
msgstr "कॉन्फिगरेशन बाह्यरेखा प्रदर्शित करा"
msgid "Display Tasker Preferences"
msgstr "टास्कर प्राधान्ये प्रदर्शित करा"
msgid "Display Prettier"
msgstr "अधिक सुंदर प्रदर्शित करा"
msgid "Display Runtime Settings"
msgstr "रनटाइम सेटिंग्ज प्रदर्शित करा"
msgid "Display TaskerNet Information"
msgstr "TaskerNet माहिती प्रदर्शित करा"
msgid "Hide Task Details Under Twisty"
msgstr "Twisty अंतर्गत कार्य तपशील लपवा"
msgid "Display Names Underlined"
msgstr "डिस्प्ले नावे अधोरेखित"
msgid "Display Pretty Output"
msgstr "सुंदर आउटपुट प्रदर्शित करा"
msgid "Everything toggled on successfully"
msgstr "सर्व काही यशस्वीरित्या चालू झाले"
msgid "Everything toggled off successfully"
msgstr "सर्व काही यशस्वीरित्या टॉगल झाले"
# AI messages
msgid "Current prompt:"
msgstr "वर्तमान सूचना:"
msgid "Enter a new prompt for the AI to use:"
msgstr "AI वापरण्यासाठी नवीन प्रॉम्प्ट प्रविष्ट करा:"
msgid "Change the Ai Prompt"
msgstr "Ai प्रॉम्प्ट बदला"
msgid "Prompt change canceled."
msgstr "त्वरित बदल रद्द केला."

msgstr "Android मिळवा XML फाइल स्थान"
msgid "Display Profile/Task Conditions"
msgstr "प्रोफाइल/कार्य अटी प्रदर्शित करा"
msgid "Display Names in Bold"
msgstr "ठळक मध्ये नावे प्रदर्शित करा"

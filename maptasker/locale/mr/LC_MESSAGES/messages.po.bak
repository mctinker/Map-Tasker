"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Language set to"
msgstr "यावर भाषा सेट केली आहे"
msgid "Display Options"
msgstr "प्रदर्शन पर्याय"
msgid "Display Detail Level:"
msgstr "डिस्प्ले तपशील स्तर:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "हे आउटपुटमध्ये प्रदर्शित केलेल्या तपशीलाचे प्रमाण निर्धारित करते.\n\nस्तर 0 = सर्वात कमी तपशील, 5 = सर्वात तपशील."
msgid "Specific Name"
msgstr "विशिष्ट नाव"
msgid "Diagram"
msgstr "आकृती"
msgid "Misc View"
msgstr "विविध दृश्य"
msgid "Analysis"
msgstr "विश्लेषण"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "तुम्ही डावीकडे एंटर केलेल्या स्ट्रिंगसाठी शोध सुरू करण्यासाठी या बटणावर क्लिक करा\nआणि शीर्षस्थानी सुरू होणारे सामने हायलाइट करा.\n\nवर क्लिक करा. अधिक माहिती मिळविण्यासाठी."
msgid "Search Here"
msgstr "येथे शोधा"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "तुम्ही डावीकडे एंटर केलेल्या स्ट्रिंगचा शोध सुरू करण्यासाठी या बटणावर क्लिक करा\nआणि स्क्रीनच्या वरच्या-डाव्या कोपऱ्यातून सुरू होणारे सामने हायलाइट करा.\n\n'?' वर क्लिक करा. अधिक माहिती मिळविण्यासाठी."
msgid "Next"
msgstr "पुढे"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "पुढील जुळलेली स्ट्रिंग दृश्यमान करा.\n\n? वर क्लिक करा. अधिक माहिती मिळविण्यासाठी."
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "मागील जुळलेली स्ट्रिंग दृश्यमान करा.\n\nअधिक माहितीसाठी ? वर क्लिक करा."
msgid "Prev"
msgstr "मागील"
msgid "Clear"
msgstr "साफ"
msgid "Search"
msgstr "शोध"
msgid "Toggle Word Wrap"
msgstr "वर्ड रॅप टॉगल करा"
msgid "Top"
msgstr "शीर्षस्थानी"
msgid "Bottom"
msgstr "तळ"
msgid "Display Only"
msgstr "फक्त प्रदर्शित करा"
msgid "Display only"
msgstr "फक्त प्रदर्शित करा"
msgid "Display only the"
msgstr "फक्त प्रदर्शित करा"
msgid "overrides any previous set name"
msgstr "कोणतेही मागील सेट नाव अधिलिखित करते"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "शोध स्ट्रिंगशी जुळणाऱ्या ओळी शोधण्यासाठी आणि प्रदर्शित करण्यासाठी या बटणावर क्लिक करा."
msgid "Profiles Per Line:"
msgstr "प्रति ओळ प्रोफाइल:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "प्रति ओळ किती प्रोफाइल\nप्रदर्शित करायचे ते निवडा.  डीफॉल्ट 6 आहे.\n\nक्लिक करा? अधिक माहिती मिळविण्यासाठी."
msgid "Top Task"
msgstr "शीर्ष कार्य"
msgid "Bottom Task"
msgstr "तळ कार्य"
msgid "Tree"
msgstr "झाड"
msgid "map_window_position"
msgstr "नकाशा_विंडो_स्थिती"
msgid "Misc"
msgstr "विविध"
msgid "misc_window_position"
msgstr "misc_window_position"
msgid "Displaying only the next 80 matches...\n"
msgstr "फक्त पुढील 80 सामने प्रदर्शित करत आहे...\n"
msgid "N/A"
msgstr "N/A"
msgid "Profiles"
msgstr "प्रोफाइल"
msgid "  Tasks in Project (sorted)"
msgstr "प्रकल्पातील कार्ये (क्रमबद्ध)"
msgid "Launcher Task: "
msgstr "लाँचर कार्य:"
msgid "<<< Owner=Project"
msgstr "<<< मालक = प्रकल्प"
msgid "Project"
msgstr "प्रकल्प"
msgid "Profile"
msgstr "प्रोफाइल"
msgid "Task"
msgstr "कार्य"
msgid "ID:"
msgstr "आयडी:"
msgid "<<< Owner="
msgstr "<<< मालक="
msgid "Element of type"
msgstr "प्रकाराचा घटक"
msgid "\n\nActions:"
msgstr "\n\nकृती:"
msgid "Action"
msgstr "कृती"
msgid "Project Global Variables"
msgstr "प्रोजेक्ट ग्लोबल व्हेरिएबल्स"
msgid "Task: "
msgstr "कार्य: "
msgid "Profile: "
msgstr "प्रोफाइल: "
msgid "Project: "
msgstr "प्रकल्प: "
msgid "Scene: "
msgstr "देखावा: "
msgid "Properties Collision Handling"
msgstr "गुणधर्म टक्कर हाताळणी"
msgid "Run Both Together"
msgstr "दोन्ही एकत्र चालवा"
msgid " Properties"
msgstr "गुणधर्म"
msgid "(Not referenced by any "
msgstr "(कोणत्याही द्वारे संदर्भित नाही"
msgid "Project:"
msgstr "प्रकल्प:"
msgid "Scenes:"
msgstr "दृश्ये:"
msgid "[Called by "
msgstr "[द्वारे म्हणतात"
msgid "[Calls "
msgstr "[कॉल्स"
msgid "(entry)"
msgstr "(प्रवेश)"
msgid "  "
msgstr ""
msgid "Directory\n"
msgstr "निर्देशिका\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "निर्देशिका (निळ्या नोंदी हॉटलिंक आहेत)\n\n"
msgid "entire configuration"
msgstr "संपूर्ण कॉन्फिगरेशन"
msgid "Profile:"
msgstr "प्रोफाइल:"
msgid "Task:"
msgstr "कार्य:"
msgid "Go to top"
msgstr "वर जा"
msgid ": Properties"
msgstr ": गुणधर्म"
msgid "Task "
msgstr "कार्य"
msgid "tasks"
msgstr "कार्ये"
msgid "Color for Background set to"
msgstr "पार्श्वभूमीसाठी रंग यावर सेट केला आहे"
msgid "highlighted for visibility"
msgstr "दृश्यमानतेसाठी हायलाइट केले"
msgid "Found:"
msgstr "सापडले:"
msgid " [Launcher Task: "
msgstr "[लाँचर कार्य:"
msgid "(Not referenced by"
msgstr "(द्वारे संदर्भित नाही"
msgid "Grand Totals"
msgstr "ग्रँड टोटल"
msgid "MapTasker Runtime Options"
msgstr "MapTasker रनटाइम पर्याय"
msgid "Just Display Everything!"
msgstr "फक्त सर्वकाही प्रदर्शित करा!"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "'ट्विस्टी' वगळता खालील सर्व चेकबॉक्स तपासते आणि डिस्प्ले पातळी कमाल तपशील स्तरावर सेट करते."
msgid "Display Profile and Task Action Conditions"
msgstr "प्रोफाइल आणि कार्य कृती अटी प्रदर्शित करा"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "आउटपुटमध्ये 'स्टेट', 'इव्हेंट', 'वेळ' इत्यादी परिस्थिती प्रदर्शित करा."
msgid "Display TaskerNet Info"
msgstr "TaskerNet माहिती प्रदर्शित करा"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "एक्सएमएल फाइलमध्ये उपलब्ध असल्यास आउटपुटमध्ये टास्कर 'प्राधान्ये' समाविष्ट करा."
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "आउटपुटच्या सुरुवातीला हॉटलिंकसह सर्व प्रोजेक्ट्स, प्रोफाइल्स, टास्क आणि सीन्सची डिरेक्टरी प्रदर्शित करा."
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "तुमचा डीफॉल्ट मजकूर संपादक असलेल्या सर्व टास्क कनेक्शनसह कॉन्फिगरेशनचा आकृती प्रदर्शित करा.\nहा पर्याय फक्त 'चालवा आणि बाहेर पडा' आणि 'पुन्हा चालवा' बटणांशी संबंधित आहे."
msgid "Display Prettier Output"
msgstr "सुंदर आउटपुट प्रदर्शित करा"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "चांगल्या आउटपुटसाठी सर्व टास्क ॲक्शन वितर्क आणि पॅरामीटर्स संरेखित करा."
msgid "Project/Profile/Task/Scene Names:"
msgstr "प्रकल्प/प्रोफाइल/कार्य/दृश्य नावे:"
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "आउटपुटमध्ये प्रोजेक्ट, प्रोफाइल आणि टास्क नावांमध्ये हायलाइटिंग जोडा."
msgid "Bold"
msgstr "ठळक"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "ठळक आणि इटालिकाइझ हे नकाशा दृश्यात परस्पर अनन्य आहेत."
msgid "Italicize"
msgstr "तिर्यक"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "मॅप व्ह्यूमध्ये इटालिकाइझ आणि बोल्ड हे परस्पर अनन्य आहेत."
msgid "Highlight"
msgstr "हायलाइट करा"
msgid "Underline"
msgstr "अधोरेखित करा"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "चेतावणी जारी करण्यापूर्वी टास्कमध्ये किती क्रिया आहेत ते निवडा.\nकॉन्फिगरेशन आउटपुटच्या तळाशी चेतावणी दिसते,\nआणि खूप पूर्ण असलेली टास्क ओळखण्यात मदत करण्याच्या उद्देशाने आहे\nआणि जे संभाव्यत: एकाधिक टास्कमध्ये विभाजित केले जावे.\n'100' ची सेटिंग म्हणजे कोणतीही मर्यादा नाही."
msgid "Creates the If/Then/Else indentation options."
msgstr "If/Then/Else इंडेंटेशन पर्याय तयार करते."
msgid "If/Then/Else Indentation Amount:"
msgstr "जर/नंतर/इतर इंडेंटेशन रक्कम:"
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "If/then/Else ब्लॉकसाठी इंडेंटेशन रक्कम सेट करा.\n\nडिफॉल्ट '4' आहे."
msgid "Creates the language selection dropdown."
msgstr "भाषा निवड ड्रॉपडाउन तयार करते."
msgid "Language:"
msgstr "भाषा:"
msgid "Creates the appearance mode selection."
msgstr "देखावा मोड निवड तयार करते."
msgid "Appearance Mode:"
msgstr "स्वरूप मोड:"
msgid "Light"
msgstr "प्रकाश"
msgid "Dark"
msgstr "गडद"
msgid "System"
msgstr "प्रणाली"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "वेगवेगळ्या दृश्यांसाठी बटणे तयार करते (नकाशा, आकृती, झाड)."
msgid "Views"
msgstr "दृश्ये"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "कार्यांमधील कनेक्शनसह, तुमच्या कॉन्फिगरेशनचे तपशीलवार दृश्य दाखवा.\n\nहे 'रीरन' बटणासारखेच आहे, परंतु आउटपुट ब्राउझरमध्ये न पाहता दुसऱ्या विंडोमध्ये प्रदर्शित केले जाते."
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "कार्यांमधील कनेक्शनसह, तुमच्या कॉन्फिगरेशनचे रेखाचित्र दृश्य दर्शवा.\n\nहे निवडलेल्या 'डिस्प्ले कॉन्फिगरेशन बाह्यरेखा' चेकबॉक्ससह एकत्रित केलेल्या 'पुन्हा चालवा' बटणासारखे आहे,\nपरंतु आउटपुट मजकूर संपादकाऐवजी दुसऱ्या विंडोमध्ये प्रदर्शित केले जाते."
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "तुमच्या कॉन्फिगरेशनचे साधे श्रेणीबद्ध ट्री व्ह्यू दाखवा."
msgid "Creates the view limit dropdown."
msgstr "दृश्य मर्यादा ड्रॉपडाउन तयार करते."
msgid "View Limit:"
msgstr "मर्यादा पहा:"
msgid "Unlimited"
msgstr "अमर्यादित"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "परवानगी देण्यासाठी दृश्यामध्ये प्रदर्शित करण्यासाठी जास्तीत जास्त आयटम निवडा.\n\nया रकमेपेक्षा जास्त काहीही असल्यास प्रोग्राम थ्रॉटल करण्याचे साधन म्हणून दृश्याची निर्मिती थांबेल.\n\nटीप: हे फक्त 'नकाशा' आणि 'डायग्राम' दृश्यांसाठी आहे, ट्री व्ह्यूसाठी नाही."
msgid "Reset Options"
msgstr "रीसेट पर्याय"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "रंग, वापरलेला फॉन्ट आणि इतर सेटिंग्ज यासह सर्व पर्याय त्यांच्या डीफॉल्ट मूल्यांवर रीसेट करा.\n\nसध्या लोड केलेले XML साफ केले जाईल."
msgid "Save Settings"
msgstr "सेटिंग्ज सेव्ह करा"
msgid "Restore Settings"
msgstr "सेटिंग्ज पुनर्संचयित करा"
msgid "Report Issue"
msgstr "समस्या कळवा"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "कोणत्याही समस्या आणि/किंवा सूचना विकासकाला कळवा.\n\nहे GitHub समस्या पृष्ठावर एक ब्राउझर विंडो उघडेल आणि समस्या सबमिट करण्यासाठी तुम्हाला GitHub खात्याची आवश्यकता असेल."
msgid "Font To Use In Output:"
msgstr "आउटपुटमध्ये वापरण्यासाठी फॉन्ट:"
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "ही तुमच्या सिस्टमवर उपलब्ध असलेल्या सर्व मोनोस्पेस फॉन्टची सूची आहे.\n\nनिवडलेला फॉन्ट सर्व आउटपुटमध्ये वापरला जाईल.\n\n'कुरियर' किंवा 'कुरियर न्यू' योग्य कनेक्टर संरेखन सुनिश्चित करण्यासाठी डायग्रामसाठी अत्यंत शिफारसीय आहे."
msgid "Clear Messages"
msgstr "मेसेज साफ करा"
msgid "Get XML from Android Device"
msgstr "Android डिव्हाइसवरून XML मिळवा"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "Android डिव्हाइसवरून XML आणा.\n\nअधिक माहितीसाठी 'Android मदत मिळवा' बटणावर क्लिक करा."
msgid "Get Local XML"
msgstr "स्थानिक XML मिळवा"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "या संगणकावरील स्थानिक ड्राइव्हवरून XML आणा.\n\nआणलेले XML MapTasker आदेशांसाठी वर्तमान स्रोत बनेल."
msgid "Display Help"
msgstr "मदत प्रदर्शित करा"
msgid "Get Android Help"
msgstr "Android मदत मिळवा"
msgid "Browser Options"
msgstr "ब्राउझर पर्याय"
msgid "Run and Exit"
msgstr "चालवा आणि बाहेर पडा"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "वर्तमान XML चा नकाशा तयार करा, परिणाम html फाईल म्हणून सेव्ह करा आणि डीफॉल्ट ब्राउझरमध्ये नकाशा प्रदर्शित करा.\n\nकार्यक्रम पूर्ण झाल्यावर समाप्त होतो."
msgid "ReRun"
msgstr "पुन्हा चालवा"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "'चालवा आणि बाहेर पडा' बटणाप्रमाणेच,\nपरंतु ब्राउझर आउटपुट प्रदर्शित केल्यानंतर प्रोग्राम रीस्टार्ट होतो."
msgid "Exit"
msgstr "बाहेर पडा"
msgid "(Pick ONLY One)"
msgstr "(फक्त एक निवडा)"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "प्रदर्शित करण्यासाठी एकच प्रकल्प, प्रोफाइल किंवा कार्य निवडा (नकाशा आणि आकृती दृश्ये आणि ब्राउझर).\nएकच प्रकल्प निवडल्यास, त्यातील सर्व प्रकल्प, कार्ये आणि दृश्ये समाविष्ट केली जातील.\nएकच प्रोफाइल निवडल्यास, ते आणि त्याची सर्व कार्ये प्रदर्शित केली जातील."
msgid "List Unnamed Items"
msgstr "नाव नसलेल्या वस्तूंची यादी करा"
msgid "'List Unnamed Items' checkbox"
msgstr "'यादी अनामित आयटम' चेकबॉक्स"
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "तुम्हाला\nपुलडाउन सूची (वरील) आणि पर्यायी निर्देशिकेत अनामित प्रोफाइल आणि कार्ये पहायची असल्यास हे तपासा.\n\nहे अनचेक ठेवल्याने अनामित कार्ये आणि प्रोफाइल्स\nपुलडाउन सूचीच्या बाहेर आणि निर्देशिकेच्या बाहेर निघून जातील,\nपरंतु अनामित प्रोफाइल आणि कार्य तपशील अद्याप आउटपुटमध्ये दिसतील."
msgid "Set Various Display Colors Here:"
msgstr "येथे विविध प्रदर्शन रंग सेट करा:"
msgid "Projects"
msgstr "प्रकल्प"
msgid "Disabled Profiles"
msgstr "अक्षम केलेले प्रोफाइल"
msgid "Launcher Tasks"
msgstr "लाँचर कार्ये"
msgid "Profile Conditions"
msgstr "प्रोफाइल अटी"
msgid "Tasks"
msgstr "कार्ये"
msgid "Unnamed Tasks"
msgstr "अनामित कार्ये"
msgid "(Task) Actions"
msgstr "(कार्य) क्रिया"
msgid "Action Conditions"
msgstr "कृती अटी"
msgid "Action Labels"
msgstr "क्रिया लेबले"
msgid "Action Names"
msgstr "क्रिया नावे"
msgid "Scenes"
msgstr "देखावे"
msgid "Background"
msgstr "पार्श्वभूमी"
msgid "TaskerNet Information"
msgstr "TaskerNet माहिती"
msgid "Tasker Preferences"
msgstr "टास्कर प्राधान्ये"
msgid "Heading"
msgstr "शीर्षक"
msgid "Reset to Default Colors"
msgstr "डीफॉल्ट रंगांवर रीसेट करा"
msgid "Show/Edit API Key(s)"
msgstr "API की(चे) दर्शवा/संपादित करा"
msgid "Change Prompt"
msgstr "प्रॉम्प्ट बदला"
msgid "Model to Use:"
msgstr "वापरण्यासाठी मॉडेल:"
msgid "Extended"
msgstr "विस्तारित"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "सर्व उपलब्ध मॉडेल्सची विस्तारित सूची प्रदर्शित करा.\n\nटीप: OpenAI किंवा Gemini साठी API की सेट केलेली नसल्यास,\nसंबंधित\nAI प्रदात्यासाठी डीफॉल्ट मॉडेल सूची प्रदर्शित केली जाईल.\n\nटीप: सर्व मॉडेल्सची पडताळणी केलेली नाही आणि\nएक किंवा अधिक विश्लेषण करताना त्रुटी देऊ शकतात."
msgid "Populates the 'Debug' tab."
msgstr "'डीबग' टॅब पॉप्युलेट करते."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "कॉन्फिगरेशन आउटपुटच्या समोर या प्रोग्रामच्या सेटिंग्ज प्रदर्शित करा (नकाशा दृश्य आणि ब्राउझर)."
msgid "API Key Options"
msgstr "API की पर्याय"
msgid "OpenAI API Key:"
msgstr "OpenAI API की:"
msgid "Claude API Key:"
msgstr "क्लॉड API की:"
msgid "DeepSeek API Key:"
msgstr "DeepSeek API की:"
msgid "Gemini API Key:"
msgstr "मिथुन API की:"
msgid "OK"
msgstr "ठीक आहे"
msgid "Cancel"
msgstr "रद्द करा"
msgid "Task 'actions' limit"
msgstr "कार्य 'कृती' मर्यादा"
msgid "Map"
msgstr "नकाशा"
msgid "Monospaced Font To Use"
msgstr "वापरण्यासाठी मोनोस्पेस्ड फॉन्ट"
msgid "Current file set to"
msgstr "वर्तमान फाइल वर सेट केली आहे"
msgid "Current File"
msgstr "वर्तमान फाइल"
msgid "Select Project to process:"
msgstr "प्रक्रिया करण्यासाठी प्रकल्प निवडा:"
msgid "Select Profile to process:"
msgstr "प्रक्रिया करण्यासाठी प्रोफाइल निवडा:"
msgid "Select Task to process:"
msgstr "प्रक्रिया करण्यासाठी कार्य निवडा:"
msgid "Display only Project"
msgstr "फक्त प्रकल्प प्रदर्शित करा"
msgid "None"
msgstr "काहीही नाही"
msgid "Display all Projects, Profiles, and Tasks."
msgstr "सर्व प्रकल्प, प्रोफाइल आणि कार्ये प्रदर्शित करा."
msgid "Display all"
msgstr "सर्व प्रदर्शित करा"
msgid "Run Analysis"
msgstr "विश्लेषण चालवा"
msgid "Analyze"
msgstr "विश्लेषण करा"
msgid "Project to Analyze:"
msgstr "विश्लेषण करण्यासाठी प्रकल्प:"
msgid "Profile to Analyze:"
msgstr "विश्लेषण करण्यासाठी प्रोफाइल:"
msgid "Task to Analyze:"
msgstr "विश्लेषण करण्यासाठी कार्य:"
msgid "No Projects, Profiles or Tasks to display!"
msgstr "प्रदर्शित करण्यासाठी कोणतेही प्रकल्प, प्रोफाइल किंवा कार्ये नाहीत!"
msgid "Analysis response is in a separate Window."
msgstr "विश्लेषण प्रतिसाद वेगळ्या विंडोमध्ये आहे."
msgid "View not possible.  No Projects, Profiles Tasks (or Scenes) in the current XML file.\n"
msgstr "दृश्य शक्य नाही.  सध्याच्या XML फाईलमध्ये कोणतेही प्रोजेक्ट, प्रोफाइल टास्क (किंवा सीन) नाहीत.\n"
msgid "Click the 'Get Local XML' or 'Get XML From Android' button to load some XML first."
msgstr "प्रथम काही XML लोड करण्यासाठी 'Get Local XML' किंवा 'Android वरून XML मिळवा' बटणावर क्लिक करा."
msgid "GUI started with the '-reset' option.\n"
msgstr "GUI ने '-reset' पर्यायाने सुरुवात केली.\n"
msgid "Initialization complete.\n"
msgstr "प्रारंभ पूर्ण.\n"
msgid "Settings restored.\n"
msgstr "सेटिंग्ज रिस्टोअर.\n"
msgid "Program running..."
msgstr "कार्यक्रम चालू आहे..."
msgid "Cancel button pressed.\n"
msgstr "रद्द करा बटण दाबले.\n"
msgid "Click 'Get Local XML' to try a different XML file."
msgstr "भिन्न XML फाइल वापरून पाहण्यासाठी 'स्थानिक XML मिळवा' वर क्लिक करा."
msgid "'Get XML From Android' settings cleared."
msgstr "'Android वरून XML मिळवा' सेटिंग्ज साफ केल्या."
msgid "No Project(s) Found in XML!"
msgstr "XML मध्ये कोणतेही प्रकल्प आढळले नाहीत!"
msgid "The 'Map' view is running in the background.  Please stand by..."
msgstr "पार्श्वभूमीत 'नकाशा' दृश्य चालू आहे.  कृपया उभे रहा..."
msgid "Map View displayed."
msgstr "नकाशा दृश्य प्रदर्शित."
msgid "msg"
msgstr "संदेश"
msgid "Colors set to defaults."
msgstr "रंग डीफॉल्टवर सेट केले."
msgid "No settings file found."
msgstr "कोणतीही सेटिंग्ज फाइल आढळली नाही."
msgid "'Get XML From Android' canceled."
msgstr "'Android वरून XML मिळवा' रद्द केले."
msgid "Red"
msgstr "लाल"
msgid "Settings reset."
msgstr "सेटिंग्ज रीसेट."
msgid "Debug mode enabled."
msgstr "डीबग मोड सक्षम केला."
msgid "Debug mode disabled."
msgstr "डीबग मोड अक्षम केला."
msgid "Tasker items set back to their default colors."
msgstr "टास्कर आयटम त्यांच्या डीफॉल्ट रंगांवर परत सेट केले."
msgid "Program updated.  Restarting..."
msgstr "कार्यक्रम अद्यतनित.  रीस्टार्ट करत आहे..."
msgid "Error: Failed to open output in browser: your browser is not supported."
msgstr "त्रुटी: ब्राउझरमध्ये आउटपुट उघडण्यात अयशस्वी: तुमचा ब्राउझर समर्थित नाही."
msgid "Selection ignored."
msgstr "निवडीकडे दुर्लक्ष केले."
msgid "No color selected."
msgstr "कोणताही रंग निवडलेला नाही."
msgid "This has no effect with Display Detail Level less than 3.  Display Detail Level set to 3!"
msgstr "3 पेक्षा कमी डिस्प्ले डिटेल लेव्हलवर याचा कोणताही परिणाम होत नाही. डिस्प्ले डिटेल लेवल 3 वर सेट केले आहे!"
msgid "'Twisty' and 'Everything' are mutually exclusive.  Unchecking 'Twisty'."
msgstr "'ट्विस्टी' आणि 'एव्हरीथिंग' परस्पर अनन्य आहेत.  'ट्विस्टी' अनचेक करत आहे."
msgid "Settings saved."
msgstr "सेटिंग्ज सेव्ह केल्या."
msgid "Tree View displayed."
msgstr "वृक्ष दृश्य प्रदर्शित."
msgid "XML must have at least one Project."
msgstr "XML मध्ये किमान एक प्रोजेक्ट असणे आवश्यक आहे."
msgid "'Cancel' button selected.  No change to the API keys!"
msgstr "'रद्द करा' बटण निवडले.  API की मध्ये कोणताही बदल नाही!"
msgid "No API keys changed."
msgstr "कोणत्याही API की बदलल्या नाहीत."
msgid "No model selected."
msgstr "कोणतेही मॉडेल निवडले नाही."
msgid "No projects, profiles, or tasks have been loaded!  Load some XML and try again."
msgstr "कोणतेही प्रकल्प, प्रोफाइल किंवा कार्ये लोड केली गेली नाहीत!  काही XML लोड करा आणि पुन्हा प्रयत्न करा."
msgid "Single Project/Profile/Task has not been selected!  Select only one and try again."
msgstr "सिंगल प्रोजेक्ट/प्रोफाइल/टास्क निवडले गेले नाही!  फक्त एक निवडा आणि पुन्हा प्रयत्न करा."
msgid "An error occurred reading the changelog file."
msgstr "चेंजलॉग फाइल वाचताना एरर आली."
msgid "The 'Diagram' view is running in the background.  Please stand by..."
msgstr "पार्श्वभूमीत 'डायग्राम' दृश्य चालू आहे.  कृपया उभे रहा..."
msgid "Diagram View displayed."
msgstr "आकृती दृश्य प्रदर्शित."
msgid "'None' selected.  Displaying all Projects, Profiles and Tasks."
msgstr "'काहीही नाही' निवडले.  सर्व प्रकल्प, प्रोफाइल आणि कार्ये प्रदर्शित करणे."
msgid "set Off"
msgstr "बंद करा"
msgid "set On"
msgstr "सेट करा"
msgid "set to False"
msgstr "असत्य वर सेट करा"
msgid "set to True"
msgstr "सत्य वर सेट करा"
msgid "is not named"
msgstr "नाव दिलेले नाही"
msgid "set to"
msgstr "वर सेट करा"
msgid "is not set"
msgstr "सेट केलेले नाही"

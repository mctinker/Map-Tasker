msgstr "Lista alla ändringar som gjorts i den inlästa XML-filen denna session, den senaste först."

msgid "Narrow to Project"
msgstr "Smal till projekt"

msgid "No changes to undo."
msgstr "Inga ändringar att ångra."

msgid "Nothing has been changed yet."
msgstr "Inget har ändrats ännu."


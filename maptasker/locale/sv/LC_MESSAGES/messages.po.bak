msgid "Language set to"
msgstr "Språk inställt på"
msgid "Display Options"
msgstr "Visningsalternativ"
msgid "Display Detail Level:"
msgstr "Visa detaljnivå:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "Detta bestämmer mängden detaljer som visas i utdata.\n\nNivå 0 = minsta detalj, 5 = mest detalj."
msgid "Specific Name"
msgstr "Specifikt namn"
msgid "Diagram"
msgstr "Diagram"
msgid "Misc View"
msgstr "Övrigt Visa"
msgid "Analysis"
msgstr "Analys"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "Klicka på den här knappen för att starta en sökning efter strängen du har skrivit till vänster\noch markera matchningarna, med början längst upp.\n\nKlicka på ? för att få mer information."
msgid "Search Here"
msgstr "Sök här"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "Klicka på den här knappen för att starta en sökning efter strängen du har skrivit till vänster\noch markera matchningarna, med början i det övre vänstra hörnet av skärmen.\n\nKlicka på '?' för att få mer information."
msgid "Next"
msgstr "Nästa"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "Gör nästa matchade sträng synlig.\n\nKlicka på ? för att få mer information."
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "Gör den föregående matchande strängen synlig.\n\nKlicka på ? för att få mer information."
msgid "Prev"
msgstr "Föreg"
msgid "Clear"
msgstr "Rensa"
msgid "Search"
msgstr "söka"
msgid "Toggle Word Wrap"
msgstr "Växla Word Wrap"
msgid "Top"
msgstr "Bästa"
msgid "Bottom"
msgstr "Botten"
msgid "Display Only"
msgstr "Endast display"
msgid "Display only"
msgstr "Endast display"
msgid "Display only the"
msgstr "Visa endast"
msgid "overrides any previous set name"
msgstr "åsidosätter alla tidigare uppsättningsnamn"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "Klicka på den här knappen för att söka efter och endast visa de rader som matchar söksträngen."
msgid "Profiles Per Line:"
msgstr "Profiler per rad:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "Välj hur många profiler\nsom ska visas per rad.  Standard är 6.\n\nKlicka på ? för att få mer information."
msgid "Top Task"
msgstr "Toppuppgift"
msgid "Bottom Task"
msgstr "Nedre uppgift"
msgid "Tree"
msgstr "Träd"
msgid "map_window_position"
msgstr "map_window_position"
msgid "Misc"
msgstr "Övrigt"
msgid "misc_window_position"
msgstr "misc_window_position"
msgid "Displaying only the next 80 matches...\n"
msgstr "Visar bara de kommande 80 matchningarna...\n"
msgid "N/A"
msgstr "N/A"
msgid "Profiles"
msgstr "Profiler"
msgid "  Tasks in Project (sorted)"
msgstr "Uppgifter i projekt (sorterade)"
msgid "Launcher Task: "
msgstr "Startuppgift:"
msgid "<<< Owner=Project"
msgstr "<<< Ägare=Projekt"
msgid "Project"
msgstr "Projekt"
msgid "Profile"
msgstr "Profil"
msgid "Task"
msgstr "Uppgift"
msgid "ID:"
msgstr "ID:"
msgid "<<< Owner="
msgstr "<<< Ägare="
msgid "Element of type"
msgstr "Element av typ"
msgid "\n\nActions:"
msgstr "\n\nÅtgärder:"
msgid "Action"
msgstr "Handling"
msgid "Project Global Variables"
msgstr "Projekt globala variabler"

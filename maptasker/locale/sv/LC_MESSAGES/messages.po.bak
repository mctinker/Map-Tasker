msgstr "Uppgift: "
msgid "Profile: "
msgstr "Profil: "
msgid "Project: "
msgstr "Projekt: "
msgid "Scene: "
msgstr "Scen: "
msgid "Properties Collision Handling"
msgstr "Egenskaper Kollisionshantering"
msgid "Run Both Together"
msgstr "Kör båda tillsammans"
msgid " Properties"
msgstr "Egenskaper"
msgid "(Not referenced by any "
msgstr "(Refereras inte av någon"
msgid "Project:"
msgstr "Projekt:"
msgid "Scenes:"
msgstr "Scener:"
msgid "[Called by "
msgstr "[Ringad av"
msgid "[Calls "
msgstr "[Ringer"
msgid "(entry)"
msgstr "(inträde)"
msgid "Directory\n"
msgstr "Katalog\n"
msgid "Directory    (blue entries are hotlinks)\n\n"
msgstr "Katalog (blå poster är snabblänkar)\n\n"
msgid "entire configuration"
msgstr "hela konfigurationen"
msgid "Profile:"
msgstr "Profil:"
msgid "Task:"
msgstr "Uppgift:"
msgid "Go to top"
msgstr "Gå till toppen"
msgid ": Properties"
msgstr ": Egenskaper"
msgid "Task "
msgstr "Uppgift"
msgid "tasks"
msgstr "uppgifter"
msgid "Color for Background set to"
msgstr "Färg för bakgrund inställd på"
msgid "highlighted for visibility"
msgstr "markerade för synlighet"
msgid "Found:"
msgstr "Hittade:"
msgid " [Launcher Task: "
msgstr "[Startuppgift:"
msgid "(Not referenced by"
msgstr "(Refereras inte av"
msgid "Grand Totals"
msgstr "Stora summor"
msgid "MapTasker Runtime Options"
msgstr "MapTasker Runtime Options"
msgid "Just Display Everything!"
msgstr "Visa bara allt!"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "Markerar alla kryssrutor nedan förutom 'twisty' och ställer in visningsnivån till maximal detaljnivå."
msgid "Display Profile and Task Action Conditions"
msgstr "Visa profil- och aktivitetsvillkor"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "Visa villkoren som 'State', 'Händelse', 'Tid', etc. i utgången."
msgid "Display TaskerNet Info"
msgstr "Visa TaskerNet Info"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "Inkludera Tasker 'preferenser' i utdata, om det är tillgängligt i XML-filen."
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "Visa en katalog med alla projekt, profiler, uppgifter och scener med snabblänkar i början av utgången."
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "Visa ett diagram över konfigurationen med alla uppgiftsanslutningar som är standardtextredigerare.\nDet här alternativet gäller bara knapparna 'Kör och avsluta' och 'Kör igen'."
msgid "Display Prettier Output"
msgstr "Visa snyggare utgång"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "Justera alla aktivitetsargument och parametrar för bättre utdata."
msgid "Project/Profile/Task/Scene Names:"
msgstr "Projekt/profil/uppgift/scennamn:"
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "Lägg till markering i projekt-, profil- och uppgiftsnamn i utdata."
msgid "Bold"
msgstr "Djärv"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "Fet och Kursiv är ömsesidigt uteslutande i kartvyn."
msgid "Italicize"
msgstr "Kursivera"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "Kursiv och fet utesluter varandra i kartvyn."
msgid "Highlight"
msgstr "Markera"
msgid "Underline"
msgstr "Betona"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "Välj hur många åtgärder i en uppgift innan du utfärdar en varning.\nVarningen visas nära botten av konfigurationsutgången,\noch är avsedd att hjälpa till att identifiera uppgifter som är för kompletta\noch som eventuellt bör delas upp i flera uppgifter.\nEn inställning på '100' betyder att det inte finns någon gräns."
msgid "Creates the If/Then/Else indentation options."
msgstr "Skapar indragsalternativen If/Then/Else."
msgid "If/Then/Else Indentation Amount:"
msgstr "Om/Då/Else Indrag belopp:"
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "Ställ in indragsbeloppet för If/Then/Else-block.\n\nStandardinställningen är '4'."
msgid "Creates the language selection dropdown."
msgstr "Skapar rullgardinsmenyn för språkval."
msgid "Language:"
msgstr "Språk:"
msgid "Creates the appearance mode selection."
msgstr "Skapar valet av utseendeläge."
msgid "Appearance Mode:"
msgstr "Utseendeläge:"
msgid "Light"
msgstr "Ljus"
msgid "Dark"
msgstr "Mörk"
msgid "System"
msgstr "System"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "Skapar knappar för olika vyer (karta, diagram, träd)."
msgid "Views"
msgstr "Visningar"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "Visa en detaljerad vy av din konfiguration, med kopplingar mellan uppgifter.\n\nDetta är identiskt med knappen 'Kör igen', men resultatet visas i ett annat fönster snarare än i en webbläsare."
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "Visa en schematisk vy av din konfiguration, med kopplingar mellan uppgifter.\n\nDetta är identiskt med knappen 'Kör igen' kombinerat med kryssrutan 'Visa konfigurationsöversikt' markerad,\nmen resultatet visas i ett annat fönster istället för i en textredigerare."
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "Visa en enkel hierarkisk trädvy av din konfiguration."
msgid "Creates the view limit dropdown."
msgstr "Skapar rullgardinsmenyn för visningsgräns."
msgid "View Limit:"
msgstr "Visningsgräns:"
msgid "Unlimited"
msgstr "Obegränsat"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "Välj det maximala antalet objekt som ska visas i vyn för att tillåtas.\n\nAllt över detta belopp kommer att stoppa genereringen av vyn som ett sätt att strypa programmet.\n\nObs: Detta är bara för vyerna 'Karta' och 'Diagram', inte trädvyn."
msgid "Reset Options"
msgstr "Återställ alternativ"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "Återställ alla alternativ till deras standardvärden, inklusive färger, använda teckensnitt och andra inställningar.\n\nDen för närvarande inlästa XML-filen kommer att raderas."
msgid "Save Settings"
msgstr "Spara inställningar"
msgid "Restore Settings"
msgstr "Återställ inställningar"
msgid "Report Issue"
msgstr "Rapportera problem"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "Rapportera eventuella problem och/eller förslag till utvecklaren.\n\nDetta öppnar ett webbläsarfönster till sidan med GitHub-problem, och du behöver ett GitHub-konto för att skicka ett problem."
msgid "Font To Use In Output:"
msgstr "Teckensnitt att använda i utdata:"
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "Det här är en lista över alla teckensnitt med monospace som finns tillgängliga på ditt system.\n\nTeckensnittet som valts kommer att användas i all utdata.\n\n'Courier' eller 'Courier New' rekommenderas starkt för Diagram för att säkerställa korrekt anslutningsjustering."
msgid "Clear Messages"
msgstr "Rensa meddelanden"
msgid "Get XML from Android Device"
msgstr "Hämta XML från Android-enhet"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "Hämta XML från en Android-enhet.\n\nKlicka på knappen 'Få Android-hjälp' för mer information."
msgid "Get Local XML"
msgstr "Skaffa lokal XML"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "Hämta XML från en lokal enhet på den här datorn.\n\nDen hämtade XML-filen blir den aktuella källan för MapTasker-kommandon."
msgid "Display Help"
msgstr "Visa hjälp"
msgid "Get Android Help"
msgstr "Få Android-hjälp"
msgid "Browser Options"
msgstr "Webbläsaralternativ"
msgid "Run and Exit"
msgstr "Kör och avsluta"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "Skapa en karta över den aktuella XML-filen, spara resultaten som en html-fil och visa kartan i standardwebbläsaren.\n\nProgrammet avslutas när det är klart."
msgid "ReRun"
msgstr "Repris"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "Samma som knappen 'Kör och avsluta',\nmen programmet startar om efter att ha visat webbläsarens utdata."
msgid "Exit"
msgstr "Utgång"
msgid "(Pick ONLY One)"
msgstr "(Välj ENDAST en)"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "Välj antingen ett projekt, en profil eller en uppgift att visa (karta- och diagramvyer och webbläsare).\nOm ett enskilt projekt väljs, kommer alla dess projekt, uppgifter och scener att inkluderas.\nOm en enskild profil är vald, kommer den och alla dess uppgifter att visas."
msgid "List Unnamed Items"
msgstr "Lista namnlösa föremål"
msgid "'List Unnamed Items' checkbox"
msgstr "Kryssrutan 'Lista namnlösa objekt'"
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "Markera detta om du vill se namnlösa profiler och uppgifter i\nrullgardinslistorna (ovan) och i den valfria katalogen.\n\nOm du lämnar detta omarkerat lämnas namnlösa uppgifter och profiler\nutanför rullgardinslistorna och utanför katalogen,\nmen de namnlösa profil- och uppgiftsdetaljerna kommer fortfarande att visas i utgången."
msgid "Set Various Display Colors Here:"
msgstr "Ställ in olika skärmfärger här:"
msgid "Projects"
msgstr "Projekt"
msgid "Disabled Profiles"
msgstr "Inaktiverade profiler"
msgid "Launcher Tasks"
msgstr "Launcher uppgifter"
msgid "Profile Conditions"
msgstr "Profilvillkor"
msgid "Tasks"
msgstr "Uppgifter"
msgid "Unnamed Tasks"
msgstr "Namnlösa: Uppgifter"
msgid "(Task) Actions"
msgstr "(Uppgift) Åtgärder"
msgid "Action Conditions"
msgstr "Åtgärdsvillkor"
msgid "Action Labels"
msgstr "Åtgärdsetiketter"
msgid "Action Names"
msgstr "Åtgärdsnamn"
msgid "Scenes"
msgstr "Scener"
msgid "Background"
msgstr "Bakgrund"
msgid "TaskerNet Information"
msgstr "TaskerNet Information"
msgid "Tasker Preferences"
msgstr "Tasker-inställningar"
msgid "Heading"
msgstr "Rubrik"
msgid "Reset to Default Colors"
msgstr "Återställ till standardfärger"
msgid "Show/Edit API Key(s)"
msgstr "Visa/redigera API-nycklar"
msgid "Change Prompt"
msgstr "Ändra prompt"
msgid "Model to Use:"
msgstr "Modell att använda:"
msgid "Extended"
msgstr "Förlängd"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "Visa en utökad lista över ALLA tillgängliga modeller.\n\nObs! Om API-nyckeln inte är inställd för OpenAI eller Gemini,\nvisas standardmodelllistan för respektive\nAI-leverantör.\n\nObs: Alla modeller har inte validerats och\ningen eller fler kan returnera ett fel vid analys."
msgid "Populates the 'Debug' tab."
msgstr "Fyller på fliken 'Debug'."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "Visa detta programs inställningar längst fram i konfigurationsutgången (Kartvy och webbläsare)."
msgid "API Key Options"
msgstr "API-nyckelalternativ"
msgid "OpenAI API Key:"
msgstr "OpenAI API-nyckel:"
msgid "Claude API Key:"
msgstr "Claude API-nyckel:"
msgid "DeepSeek API Key:"
msgstr "DeepSeek API-nyckel:"
msgid "Gemini API Key:"
msgstr "Gemini API-nyckel:"
msgid "OK"
msgstr "OK"
msgid "Cancel"
msgstr "Avboka"
msgid "Task 'actions' limit"
msgstr "Uppgiftens gräns för åtgärder"
msgid "Map"
msgstr "Karta"
msgid "Monospaced Font To Use"
msgstr "Monospaced teckensnitt att använda"
msgid "Current file set to"
msgstr "Aktuell fil inställd på"
msgid "Current File"
msgstr "Aktuell fil"
msgid "Select Project to process:"
msgstr "Välj projekt att bearbeta:"
msgid "Select Profile to process:"
msgstr "Välj profil att bearbeta:"
msgid "Select Task to process:"
msgstr "Välj uppgift att bearbeta:"
msgid "Display only Project"
msgstr "Visa endast projekt"
msgid "None"
msgstr "Ingen"
msgid "Display all Projects, Profiles, Tasks, and Scenes."
msgstr "Visa alla projekt, profiler och uppgifter."
msgid "Display all"
msgstr "Visa alla"
msgid "Run Analysis"
msgstr "Kör analys"
msgid "Analyze"
msgstr "Analysera"
msgid "Project to Analyze:"
msgstr "Projekt att analysera:"
msgid "Profile to Analyze:"
msgstr "Profil att analysera:"
msgid "Task to Analyze:"
msgstr "Uppgift att analysera:"
msgid "No Projects, Profiles or Tasks to display!"
msgstr "Inga projekt, profiler eller uppgifter att visa!"
msgid "Analysis response is in a separate Window."
msgstr "Analyssvar finns i ett separat fönster."
msgid "View not possible.  No Projects, Profiles Tasks (or Scenes) in the current XML file.\n"
msgstr "Visa inte möjligt.  Inga projekt, profiluppgifter (eller scener) i den aktuella XML-filen.\n"
msgid "Click the 'Get Local XML' or 'Get XML From Android' button to load some XML first."
msgstr "Klicka på knappen 'Hämta lokal XML' eller 'Hämta XML från Android' för att ladda lite XML först."
msgid "GUI started with the '-reset' option.\n"
msgstr "GUI startade med alternativet '-reset'.\n"
msgid "Initialization complete.\n"
msgstr "Initiering klar.\n"
msgid "Settings restored.\n"
msgstr "Inställningarna har återställts.\n"
msgid "Program running..."
msgstr "Program körs..."
msgid "Cancel button pressed.\n"
msgstr "Avbryt-knappen nedtryckt.\n"
msgid "Invalid XML!  Click 'Get Local XML File' to try a different XML file."
msgstr "Klicka på 'Hämta lokal XML' för att prova en annan XML-fil."
msgid "'Get XML From Android' settings cleared."
msgstr "Inställningarna för 'Hämta XML från Android' har rensats."
msgid "No Project(s) Found in XML!"
msgstr "Inga projekt hittades i XML!"
msgid "The 'Map' view is running in the background.  Please stand by..."
msgstr "'Karta'-vyn körs i bakgrunden.  Snälla stå vid sidan..."
msgid "Map View displayed."
msgstr "Kartvy visas."
msgid "msg"
msgstr "medd"
msgid "Colors set to defaults."
msgstr "Färger inställda på standardvärden."
msgid "No settings file found."
msgstr "Ingen inställningsfil hittades."
msgid "'Get XML From Android' canceled."
msgstr "'Hämta XML från Android' avbröts."
msgid "Red"
msgstr "Röd"
msgid "Settings reset."
msgstr "Inställningar återställs."
msgid "Debug mode enabled."
msgstr "Felsökningsläge aktiverat."
msgid "Debug mode disabled."
msgstr "Felsökningsläge inaktiverat."
msgid "Tasker items set back to their default colors."
msgstr "Tasker-objekt återställs till sina standardfärger."
msgid "Program updated.  Restarting..."
msgstr "Program uppdaterat.  Startar om..."
msgid "Error: Failed to open output in browser: your browser is not supported."
msgstr "Fel: Det gick inte att öppna utdata i webbläsaren: din webbläsare stöds inte."
msgid "Selection ignored."
msgstr "Urval ignoreras."
msgid "No color selected."
msgstr "Ingen färg har valts."
msgid "This has no effect with Display Detail Level less than 3.  Display Detail Level set to 3!"
msgstr "Detta har ingen effekt med Display Detail Level mindre än 3. Display Detail Level inställd på 3!"
msgid "'Twisty' and 'Everything' are mutually exclusive.  Unchecking 'Twisty'."
msgstr "'Twisty' och 'Allt' utesluter varandra.  Avmarkera 'Twisty'."
msgid "Settings saved."
msgstr "Inställningar sparade."
msgid "Tree View displayed."
msgstr "Trädvy visas."
msgid "XML must have at least one Project."
msgstr "XML måste ha minst ett projekt."
msgid "'Cancel' button selected.  No change to the API keys!"
msgstr "'Avbryt'-knappen vald.  Ingen förändring av API-nycklarna!"
msgid "No API keys changed."
msgstr "Inga API-nycklar har ändrats."
msgid "No model selected."
msgstr "Ingen modell har valts."
msgid "No projects, profiles, or tasks have been loaded!  Load some XML and try again."
msgstr "Inga projekt, profiler eller uppgifter har laddats!  Ladda lite XML och försök igen."
msgid "Single Project/Profile/Task has not been selected!  Select only one and try again."
msgstr "Enstaka projekt/profil/uppgift har inte valts!  Välj bara en och försök igen."
msgid "An error occurred reading the changelog file."
msgstr "Ett fel uppstod när ändringsloggfilen lästes."
msgid "The 'Diagram' view is running in the background.  Please stand by..."
msgstr "'Diagram'-vyn körs i bakgrunden.  Snälla stå vid sidan..."
msgid "Diagram View displayed."
msgstr "Diagramvy visas."
msgid "'None' selected.  Displaying all Projects, Profiles and Tasks."
msgstr "'Ingen' har valts.  Visar alla projekt, profiler och uppgifter."
msgid "set Off"
msgstr "sätta av"
msgid "set On"
msgstr "sätt på"
msgid "set to False"
msgstr "inställd på False"
msgid "set to True"
msgstr "inställd på Sant"
msgid "is not named"
msgstr "är inte namngiven"
msgid "set to"
msgstr "inställd på"
msgid "is not set"
msgstr "är inte inställd"
 # Restore settings text
msgid "Android Get XML TCP IP Address"
msgstr "Android Hämta XML TCP IP-adress"
msgid "ndroid Get XML Port Number"
msgstr "ndroid Hämta XML-portnummer"
msgid "Android Get XML File Location"
msgstr "Android Hämta XML-filplats"
msgid "Display Profile/Task Conditions"
msgstr "Visa profil/uppgiftsvillkor"
msgid "Display Names in Bold"
msgstr "Visa namn i fetstil"
msgid "Debug Mode"
msgstr "Felsökningsläge"
msgid "Display Directory"
msgstr "Visa katalog"
msgid "Display Names Highlighted"
msgstr "Visningsnamn markerade"
msgid "Display Names Italicized"
msgstr "Visningsnamn kursiverade"
msgid "Display Unnamed Tasks"
msgstr "Visa namnlösa uppgifter"
msgid "Display Configuration Outline"
msgstr "Visa konfigurationsöversikt"
msgid "Display Tasker Preferences"
msgstr "Visa Tasker-inställningar"
msgid "Display Prettier"
msgstr "Visa snyggare"
msgid "Display Runtime Settings"
msgstr "Visa körtidsinställningar"
msgid "Display TaskerNet Information"
msgstr "Visa TaskerNet-information"
msgid "Hide Task Details Under Twisty"
msgstr "Dölj uppgiftsdetaljer under Twisty"
msgid "Display Names Underlined"
msgstr "Visningsnamn understrukna"
msgid "Display Pretty Output"
msgstr "Visar vacker utgång"
msgid "Everything toggled on successfully"
msgstr "Allt fungerade framgångsrikt"
msgid "Everything toggled off successfully"
msgstr "Allt stängdes av framgångsrikt"
 # AI messages
msgid "Current prompt:"
msgstr "Aktuell uppmaning:"
msgid "Enter a new prompt for the AI to use:"
msgstr "Ange en ny uppmaning som AI ska använda:"

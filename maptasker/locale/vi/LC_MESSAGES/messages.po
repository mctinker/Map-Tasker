msgid "Language set to"
msgstr "Ngôn ngữ được đặt thành"
msgid "Display Options"
msgstr "Tùy chọn hiển thị"
msgid "Display Detail Level:"
msgstr "Hiển thị mức độ chi tiết:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "Điều này xác định lượng chi tiết được hiển thị ở đầu ra.\n\nCấp 0 = chi tiết ít nhất, 5 = chi tiết nhất."
msgid "Specific Name"
msgstr "Tên cụ thể"
msgid "Diagram"
msgstr "Sơ đồ"
msgid "Misc View"
msgstr "Chế độ xem khác"
msgid "Analysis"
msgstr "Phân tích"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "Nhấp vào nút này để bắt đầu tìm kiếm chuỗi bạn đã nhập ở bên trái\nvà đánh dấu các kết quả phù hợp, bắt đầu từ trên cùng.\n\nNhấp vào ? để biết thêm thông tin."
msgid "Search Here"
msgstr "Tìm kiếm ở đây"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "Nhấp vào nút này để bắt đầu tìm kiếm chuỗi bạn đã nhập ở bên trái\nvà đánh dấu các kết quả phù hợp, bắt đầu từ góc trên cùng bên trái của màn hình.\n\nNhấp vào '?' để biết thêm thông tin."
msgid "Next"
msgstr "Kế tiếp"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "Hiển thị chuỗi khớp tiếp theo.\n\nNhấp vào ? để biết thêm thông tin."
msgid "Make the previous matched string visible.\n\nClick the ? to get more info."
msgstr "Hiển thị chuỗi đã khớp trước đó.\n\nNhấp vào dấu ? để biết thêm thông tin."
msgid "Prev"
msgstr "Trước"
msgid "Clear"
msgstr "Thông thoáng"
msgid "Search"
msgstr "tìm kiếm"
msgid "Toggle Word Wrap"
msgstr "Chuyển đổi gói từ"
msgid "Top"
msgstr "Đứng đầu"
msgid "Bottom"
msgstr "Đáy"
msgid "Display Only"
msgstr "Chỉ hiển thị"
msgid "Display only"
msgstr "Chỉ hiển thị"
msgid "Display only the"
msgstr "Chỉ hiển thị"
msgid "overrides any previous set name"
msgstr "ghi đè mọi tên đã đặt trước đó"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "Bấm vào nút này để tìm kiếm và chỉ hiển thị các dòng khớp với chuỗi tìm kiếm."
msgid "Profiles Per Line:"
msgstr "Hồ sơ trên mỗi dòng:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "Chọn số lượng Hồ sơ\nđể hiển thị trên mỗi dòng.  Mặc định là 6.\n\nNhấp vào ? để biết thêm thông tin."

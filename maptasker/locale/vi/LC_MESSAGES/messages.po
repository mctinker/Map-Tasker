msgid "Grand Totals"
msgstr "Tổng cộng"
msgid "MapTasker Runtime Options"
msgstr "Tùy chọn thời gian chạy MapTasker"
msgid "Just Display Everything!"
msgstr "Chỉ cần hiển thị mọi thứ!"
msgid "Checks all of the below checkboxes except for 'twisty' and sets the display level to the maximum detail level."
msgstr "Chọn tất cả các hộp kiểm bên dưới ngoại trừ 'xoắn' và đặt mức hiển thị ở mức chi tiết tối đa."
msgid "Display Profile and Task Action Conditions"
msgstr "Hiển thị hồ sơ và điều kiện hành động nhiệm vụ"
msgid "Display the conditions such as 'State', 'Event', 'Time', etc. in the output."
msgstr "Hiển thị các điều kiện như 'Trạng thái', 'Sự kiện', 'Thời gian', v.v. ở đầu ra."
msgid "Display TaskerNet Info"
msgstr "Hiển thị thông tin TaskerNet"
msgid "Include the Tasker 'preferences' in the output, if available in the XML file."
msgstr "Bao gồm 'tùy chọn' của Tác vụ trong đầu ra, nếu có trong tệp XML."
msgid "Display a directory of all Projects, Profiles, Tasks and Scenes with hotlinks at the beginning of the output."
msgstr "Hiển thị thư mục gồm tất cả Dự án, Hồ sơ, Nhiệm vụ và Cảnh có liên kết nóng ở đầu đầu ra."
msgid "Display a diagram of the configuration with all Task connections your the default text editor.\nThis option only relates to the 'Run and Exit' and 'ReRun' buttons."
msgstr "Hiển thị sơ đồ cấu hình với tất cả các kết nối Tác vụ với trình soạn thảo văn bản mặc định của bạn.\nTùy chọn này chỉ liên quan đến các nút 'Chạy và Thoát' và 'Chạy lại'."
msgid "Display Prettier Output"
msgstr "Hiển thị đầu ra đẹp hơn"
msgid "Align all Task action arguments and parameters for nicer output."
msgstr "Căn chỉnh tất cả các đối số và tham số của tác vụ để có đầu ra đẹp hơn."
msgid "Project/Profile/Task/Scene Names:"
msgstr "Tên dự án/Hồ sơ/Nhiệm vụ/Cảnh:"
msgid "Add highlighting to Project, Profile and Task names in the output."
msgstr "Thêm phần đánh dấu vào tên Dự án, Hồ sơ và Nhiệm vụ ở đầu ra."
msgid "Bold"
msgstr "In đậm"
msgid "Bold and Italicize are mutually exclusive in the Map view."
msgstr "In đậm và in nghiêng loại trừ lẫn nhau trong chế độ xem Bản đồ."
msgid "Italicize"
msgstr "in nghiêng"
msgid "Italicize and Bold are mutually exclusive in the Map view."
msgstr "In nghiêng và in đậm loại trừ lẫn nhau trong chế độ xem Bản đồ."
msgid "Highlight"
msgstr "Điểm nổi bật"
msgid "Underline"
msgstr "gạch chân"
msgid "Select how many actions in a Task before issuing a warning.\nThe warning appears near th4e bottom of the configuration output,\nand is intended to help identify Tasks that are too comple\nand which should potentially be broken up into multiple Tasks.\nA setting of '100' means there is no limit."
msgstr "Chọn số lượng hành động trong một Nhiệm vụ trước khi đưa ra cảnh báo.\nCảnh báo xuất hiện ở gần cuối đầu ra cấu hình,\nand nhằm giúp xác định các Nhiệm vụ quá phức tạp\nvà có khả năng bị chia thành nhiều Nhiệm vụ.\nCài đặt '100' nghĩa là không có giới hạn."
msgid "Creates the If/Then/Else indentation options."
msgstr "Tạo các tùy chọn thụt lề If/Then/Else."
msgid "If/Then/Else Indentation Amount:"
msgstr "Số lượng thụt lề nếu/thì/khác:"
msgid "Set the indentation amount for If/Then/Else blocks.\n\nThe default is '4'."
msgstr "Đặt mức thụt lề cho các khối If/Then/Else.\n\nMặc định là '4'."
msgid "Creates the language selection dropdown."
msgstr "Tạo danh sách thả xuống lựa chọn ngôn ngữ."
msgid "Language:"
msgstr "Ngôn ngữ:"
msgid "Creates the appearance mode selection."
msgstr "Tạo lựa chọn chế độ xuất hiện."
msgid "Appearance Mode:"
msgstr "Chế độ xuất hiện:"
msgid "Light"
msgstr "Ánh sáng"
msgid "Dark"
msgstr "Tối tăm"
msgid "System"
msgstr "Hệ thống"
msgid "Creates buttons for different views (Map, Diagram, Tree)."
msgstr "Tạo các nút cho các chế độ xem khác nhau (Bản đồ, Sơ đồ, Cây)."
msgid "Views"
msgstr "Lượt xem"
msgid "Show a detailed view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button, but the output is displayed inside another window rather than in a browser."
msgstr "Hiển thị chế độ xem chi tiết về cấu hình của bạn, với các kết nối giữa các tác vụ.\n\nĐiều này giống hệt với nút 'Chạy lại', nhưng đầu ra được hiển thị bên trong một cửa sổ khác chứ không phải trong trình duyệt."
msgid "Show a diagrammatic view of your configuration, with connections between tasks.\n\nThis is identical to the 'ReRun' button combined with the 'Display Configuration Outline' checkbox selected,\nbut the output is displayed inside another window rather than in a text editor."
msgstr "Hiển thị chế độ xem sơ đồ cấu hình của bạn, với các kết nối giữa các tác vụ.\n\nĐiều này giống hệt với nút 'Chạy lại' được kết hợp với hộp kiểm 'Hiển thị dàn ý cấu hình' được chọn,\nnhưng đầu ra được hiển thị bên trong một cửa sổ khác chứ không phải trong trình soạn thảo văn bản."
msgid "Show a simple hierarchical tree view of your configuration."
msgstr "Hiển thị chế độ xem dạng cây phân cấp đơn giản cho cấu hình của bạn."
msgid "Creates the view limit dropdown."
msgstr "Tạo danh sách thả xuống giới hạn chế độ xem."
msgid "View Limit:"
msgstr "Giới hạn lượt xem:"
msgid "Unlimited"
msgstr "Không giới hạn"
msgid "Select the maximum number of items to display in the view to be allowed.\n\nAnything over this amount will stop the generation of the view as a means to throttle the program.\n\nNote: This is only for the 'Map' and 'Diagram' views, not the tree view."
msgstr "Chọn số lượng mục tối đa được phép hiển thị trong chế độ xem.\n\nBất cứ điều gì vượt quá số lượng này sẽ dừng việc tạo chế độ xem như một phương tiện để điều tiết chương trình.\n\nLưu ý: Điều này chỉ dành cho chế độ xem 'Bản đồ' và 'Sơ đồ', không phải cho chế độ xem dạng cây."
msgid "Reset Options"
msgstr "Đặt lại tùy chọn"
msgid "Reset all of the options to their default values, including colors, font used, and other settings.\n\nThe currently loaded XML will be cleared out."
msgstr "Đặt lại tất cả các tùy chọn về giá trị mặc định, bao gồm màu sắc, phông chữ được sử dụng và các cài đặt khác.\n\nXML hiện được tải sẽ bị xóa."
msgid "Save Settings"
msgstr "Lưu cài đặt"
msgid "Restore Settings"
msgstr "Khôi phục cài đặt"
msgid "Report Issue"
msgstr "Báo cáo vấn đề"
msgid "Report any issues and/or suggestions to the developer.\n\nThis will open a browser window to the GitHub Issues page, and you will need a GitHub account to submit an issue."
msgstr "Báo cáo mọi vấn đề và/hoặc đề xuất cho nhà phát triển.\n\nThao tác này sẽ mở một cửa sổ trình duyệt tới trang Vấn đề GitHub và bạn sẽ cần có tài khoản GitHub để gửi vấn đề."
msgid "Font To Use In Output:"
msgstr "Phông chữ để sử dụng trong đầu ra:"
msgid "This is a list of all of the monospaced fonts available on your system.\n\nThe font selected will be used in all output.\n\n'Courier' or 'Courier New' is highly recommended for Diagrams to ensure proper connector alignment."
msgstr "Đây là danh sách tất cả các phông chữ đơn cách có sẵn trên hệ thống của bạn.\n\nPhông chữ đã chọn sẽ được sử dụng trong tất cả đầu ra.\n\n'Courier' hoặc 'Courier New' được khuyến khích sử dụng cho Sơ đồ để đảm bảo căn chỉnh đầu nối thích hợp."
msgid "Clear Messages"
msgstr "Xóa tin nhắn"
msgid "Get XML from Android Device"
msgstr "Nhận XML từ thiết bị Android"
msgid "Fetch XML from an Android device.\n\nClick on the 'Get Android Help' button for more info."
msgstr "Tìm nạp XML từ thiết bị Android.\n\nNhấp vào nút 'Nhận trợ giúp Android' để biết thêm thông tin."
msgid "Get Local XML"
msgstr "Nhận XML cục bộ"
msgid "Fetch XML from a local drive on this computer.\n\nThe XML fetched will become the current source for MapTasker commands."
msgstr "Tìm nạp XML từ ổ đĩa cục bộ trên máy tính này.\n\nXML được tìm nạp sẽ trở thành nguồn hiện tại cho các lệnh MapTasker."
msgid "Display Help"
msgstr "Hiển thị trợ giúp"
msgid "Get Android Help"
msgstr "Nhận trợ giúp về Android"
msgid "Browser Options"
msgstr "Tùy chọn trình duyệt"
msgid "Run and Exit"
msgstr "Chạy và thoát"
msgid "Generate a map of the current XML, save the results as an html file and display the map in the default browser.\n\nThe program terminates when done."
msgstr "Tạo bản đồ của XML hiện tại, lưu kết quả dưới dạng tệp html và hiển thị bản đồ trong trình duyệt mặc định.\n\nChương trình sẽ kết thúc khi hoàn tất."
msgid "ReRun"
msgstr "Chạy lại"
msgid "Same as the 'Run and Exit' button,\nbut the program restarts after displaying the browser output."
msgstr "Tương tự như nút 'Chạy và Thoát',\nnhưng chương trình sẽ khởi động lại sau khi hiển thị kết quả đầu ra của trình duyệt."
msgid "Exit"
msgstr "Ra"
msgid "(Pick ONLY One)"
msgstr "(CHỈ chọn một)"
msgid "Select either a single Project, Profile, or Task to display (Map and Diagram views, and browser).\nIf a single Project is selected, all of it's Projects, Tasks and Scenes will be included.\nIf a single Profile is selected, it and all of its Tasks will be displayed."
msgstr "Chọn một Dự án, Hồ sơ hoặc Nhiệm vụ để hiển thị (Chế độ xem Bản đồ và Sơ đồ cũng như trình duyệt).\nNếu một Dự án duy nhất được chọn, tất cả các Dự án, Nhiệm vụ và Cảnh của nó sẽ được bao gồm.\nNếu một Hồ sơ duy nhất được chọn, nó và tất cả các Nhiệm vụ của nó sẽ được hiển thị."
msgid "List Unnamed Items"
msgstr "Liệt kê các mục không có tên"
msgid "'List Unnamed Items' checkbox"
msgstr "Hộp kiểm 'Liệt kê các mục chưa được đặt tên'"
msgid "Check this if you want to see unnamed Profiles and Tasks in the\npulldown lists (above) and in the optional directory.\n\nLeaving this unchecked will leave unnamed Tasks and Profiles\nout of the pulldown lists and out of the directory,\nbut the unnamed Profile and Task details will still appear in the output."
msgstr "Chọn tùy chọn này nếu bạn muốn xem Hồ sơ và Nhiệm vụ chưa được đặt tên trong\ndanh sách kéo xuống (ở trên) và trong thư mục tùy chọn.\n\nViệc bỏ chọn phần này sẽ khiến Nhiệm vụ và Hồ sơ chưa được đặt tên\n nằm ngoài danh sách kéo xuống và ra khỏi thư mục,\nnhưng chi tiết về Hồ sơ và Nhiệm vụ chưa được đặt tên sẽ vẫn xuất hiện ở đầu ra."
msgid "Set Various Display Colors Here:"
msgstr "Đặt nhiều màu hiển thị khác nhau tại đây:"
msgid "Projects"
msgstr "Dự án"
msgid "Disabled Profiles"
msgstr "Hồ sơ bị vô hiệu hóa"
msgid "Launcher Tasks"
msgstr "Nhiệm vụ của trình khởi chạy"
msgid "Profile Conditions"
msgstr "Điều kiện hồ sơ"
msgid "Tasks"
msgstr "Nhiệm vụ"
msgid "Unnamed Tasks"
msgstr "Nhiệm vụ không tên"
msgid "(Task) Actions"
msgstr "(Nhiệm vụ) Hành động"
msgid "Action Conditions"
msgstr "Điều kiện hành động"
msgid "Action Labels"
msgstr "Nhãn hành động"
msgid "Action Names"
msgstr "Tên hành động"
msgid "Scenes"
msgstr "cảnh"
msgid "Background"
msgstr "Lý lịch"
msgid "TaskerNet Information"
msgstr "Thông tin về TaskerNet"
msgid "Tasker Preferences"
msgstr "Tùy chọn tác vụ"
msgid "Heading"
msgstr "tiêu đề"
msgid "Reset to Default Colors"
msgstr "Đặt lại về màu mặc định"
msgid "Show/Edit API Key(s)"
msgstr "Hiển thị/Chỉnh sửa (các) Khóa API"
msgid "Change Prompt"
msgstr "Thay đổi lời nhắc"
msgid "Model to Use:"
msgstr "Mô hình sử dụng:"
msgid "Extended"
msgstr "Mở rộng"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "Hiển thị danh sách mở rộng TẤT CẢ các mô hình có sẵn.\n\nLưu ý: Nếu khóa API không được đặt cho OpenAI hoặc Gemini,\nthì danh sách mô hình mặc định cho nhà cung cấp\nAI tương ứng sẽ được hiển thị.\n\nLưu ý: Không phải tất cả các mô hình đều đã được xác thực và\nkhông có mô hình nào trở lên có thể trả về lỗi khi phân tích."
msgid "Populates the 'Debug' tab."
msgstr "Điền vào tab 'Gỡ lỗi'."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "Hiển thị cài đặt của chương trình này ở phía trước đầu ra cấu hình (Chế độ xem bản đồ và trình duyệt)."
msgid "API Key Options"
msgstr "Tùy chọn khóa API"
msgid "OpenAI API Key:"
msgstr "Khóa API OpenAI:"
msgid "Claude API Key:"

msgstr "(Завдання) Дії"
msgid "Action Conditions"
msgstr "Умови акції"
msgid "Action Labels"
msgstr "Етикетки дій"
msgid "Action Names"
msgstr "Назви дій"
msgid "Scenes"
msgstr "Сцени"
msgid "Background"
msgstr "Фон"
msgid "TaskerNet Information"
msgstr "Інформація TaskerNet"
msgid "Tasker Preferences"
msgstr "Налаштування Tasker"
msgid "Heading"
msgstr "Заголовок"
msgid "Reset to Default Colors"
msgstr "Відновити кольори за замовчуванням"
msgid "Show/Edit API Key(s)"
msgstr "Показати/змінити ключ(и) API"
msgid "Change Prompt"
msgstr "Змінити підказку"
msgid "Model to Use:"
msgstr "Модель для використання:"
msgid "Extended"
msgstr "Розширений"
msgid "Display an extended list of ALL available models.\n\nNote: If the API key is not set for OpenAI or Gemini,\nthen the default model list for the respective\nAI provider will be displayed.\n\nNote: Not all models have been validated and\none or more may return an error on analysis."
msgstr "Відобразити розширений список УСІХ доступних моделей.\n\nПримітка: якщо ключ API не встановлено для OpenAI або Gemini,\nтоді буде відображено список моделей за замовчуванням для відповідного\nпостачальника штучного інтелекту.\n\nПримітка: не всі моделі перевірено, і\nжодна або більше можуть давати помилку під час аналізу."
msgid "Populates the 'Debug' tab."
msgstr "Заповнює вкладку «Налагодження»."
msgid "Display this program's settings at the front of the configuration output (Map view and browser)."
msgstr "Відображати параметри цієї програми на початку виводу конфігурації (перегляд карти та браузер)."
msgid "API Key Options"
msgstr "Ключові параметри API"
msgid "OpenAI API Key:"
msgstr "Ключ OpenAI API:"
msgid "Claude API Key:"
msgstr "Ключ API Claude:"
msgid "DeepSeek API Key:"
msgstr "Ключ API DeepSeek:"
msgid "Gemini API Key:"
msgstr "Ключ Gemini API:"
msgid "OK"
msgstr "добре"
msgid "Cancel"
msgstr "Скасувати"
msgid "Task 'actions' limit"
msgstr "Ліміт «дій» завдання"
msgid "Map"
msgstr "Карта"
msgid "Monospaced Font To Use"
msgstr "Моноширинний шрифт для використання"
msgid "Current file set to"
msgstr "Для поточного файлу встановлено значення"
msgid "Current File"
msgstr "Поточний файл"
msgid "Select Project to process:"
msgstr "Виберіть проект для обробки:"
msgid "Select Profile to process:"
msgstr "Виберіть профіль для обробки:"
msgid "Select Task to process:"
msgstr "Виберіть завдання для обробки:"
msgid "Display only Project"
msgstr "Показати лише проект"
msgid "None"
msgstr "Жодного"
msgid "Display all Projects, Profiles, Tasks, and Scenes."
msgstr "Показати всі проекти, профілі та завдання."
msgid "Display all"
msgstr "Показати все"
msgid "Run Analysis"
msgstr "Запустити аналіз"
msgid "Analyze"
msgstr "Аналізуйте"
msgid "Project to Analyze:"
msgstr "Проект для аналізу:"
msgid "Profile to Analyze:"
msgstr "Профіль для аналізу:"
msgid "Task to Analyze:"
msgstr "Завдання для аналізу:"
msgid "No Projects, Profiles or Tasks to display!"
msgstr "Немає проектів, профілів або завдань для відображення!"
msgid "Analysis response is in a separate Window."

msgstr "השפה מוגדרת ל"
msgid "Display Options"
msgstr "אפשרויות תצוגה"
msgid "Display Detail Level:"
msgstr "רמת פרטי תצוגה:"
msgid "This determines the amount of detail displayed in the output.\n\nLevel 0 = the least detail, 5 = the most detail."
msgstr "זה קובע את כמות הפרטים המוצגים בפלט.\n\nרמה 0 = הכי פחות פרט, 5 = הכי הרבה פרטים."
msgid "Specific Name"
msgstr "שם ספציפי"
msgid "Diagram"
msgstr "תַרשִׁים"
msgid "Misc View"
msgstr "תצוגה שונה"
msgid "Analysis"
msgstr "אָנָלִיזָה"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top.\n\nClick the ? to get more info."
msgstr "לחץ על כפתור זה כדי להתחיל חיפוש אחר המחרוזת שהזנת משמאל\nוהדגש את ההתאמות, החל מלמעלה.\n\nלחץ על ? כדי לקבל מידע נוסף."
msgid "Search Here"
msgstr "חפש כאן"
msgid "Click this button to initiate a search for the string you have entered to the left\nand highlight the matches, starting at the top-left corner of the screen.\n\nClick the '?' to get more info."
msgstr "לחץ על לחצן זה כדי להתחיל חיפוש אחר המחרוזת שהזנת משמאל\nוהדגש את ההתאמות, החל מהפינה השמאלית העליונה של המסך.\n\nלחץ על '?' כדי לקבל מידע נוסף."
msgid "Next"
msgstr "הַבָּא"
msgid "Make the next matched string visible.\n\nClick the ? to get more info."
msgstr "הפוך את המחרוזת התואמת הבאה לגלויה.\n\nלחץ על ? כדי לקבל מידע נוסף."
msgid "Prev"
msgstr "הקודם"
msgid "Clear"
msgstr "בָּרוּר"
msgid "search"
msgstr "לְחַפֵּשׂ"
msgid "Toggle Word Wrap"
msgstr "החלף את גלישת מילים"
msgid "Top"
msgstr "רֹאשׁ"
msgid "Bottom"
msgstr "תַחתִית"
msgid "Display Only"
msgstr "תצוגה בלבד"
msgid "Display only"
msgstr "תצוגה בלבד"
msgid "Display only the"
msgstr "הצג רק את"
msgid "overrides any previous set name"
msgstr "עוקף כל שם של קבוצה קודמת"
msgid "Click this button to search for and display only the lines that match the search string."
msgstr "לחץ על כפתור זה כדי לחפש ולהציג רק את השורות התואמות למחרוזת החיפוש."
msgid "Profiles Per Line:"
msgstr "פרופילים לכל שורה:"
msgid "Select how many Profiles\nto display per line.  The default is 6.\n\nClick the ? to get more info."
msgstr "בחר כמה פרופילים\nלהציג בכל שורה.  ברירת המחדל היא 6.\n\nלחץ על ? כדי לקבל מידע נוסף."

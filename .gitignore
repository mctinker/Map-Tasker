# ignore all root items
/*

# unignore folders: files and folders to ignore (the / is optional - I just think it looks nice)
!**/src/*.py
!**/tests/*.py
!docs/

# unignore files: files and folders to not ignore
!.gitignore
!Changelog.md
!Build.txt
!README.md
!README_PyPl.md
!pyproject.toml
!maptasker
!tests
dmg_builder
#!*.html


# recursively re-ignore
__pycache__
.claude
